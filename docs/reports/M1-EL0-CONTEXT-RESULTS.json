  "initial_harness_issues": [
    "First link attempted implicit libc memcpy for exception-frame assignment; fixed with explicit volatile field copy.",
    "Model-only build found unused direct-key helper under -Werror; helper now compiled only for the architecture profile."
  ],
  "observations": [
    "All expected negative runs exited 1 with their specific marker, never with host timeout.",
    "Wrong-key runs observed ESR_EL1=0x72000000 in actual EL0 authentication failure.",
    "EL0-only page access, read-only code and UXN each generated specifically checked lower-EL permission faults.",
    "Opt-in HVC model restored expected privileged key bank on IRQ/SVC while preserving user signatures across resumption."
  ],
  "limitations": [
    "One vCPU scheduling two synthetic tasks, not multicore EL0 or a real OS.",
    "Integer register/frame state only; no FP/SIMD/SVE/TLS or nested interrupts.",
    "QEMU variants share implementation, not independent physical hardware tests.",
    "No new Apple firmware execution, TSS call, iBEC, XNU, guest GPU rendering, or performance result."
  ],
