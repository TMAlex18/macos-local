diff --git a/hw/vmapple/bdif.c b/hw/vmapple/bdif.c
--- a/hw/vmapple/bdif.c
+++ b/hw/vmapple/bdif.c
@@ -36,6 +36,7 @@
     guint usb_tx_watch;
     bool usb_tx_ready;
     uint32_t usb_queue;
+    uint32_t usb_queue_control;
     bool usb_rx_ready;
     bool usb_rx_posted;
     uint64_t usb_rx_addr;
@@ -58,6 +59,7 @@
 #define REG_BUSY            0x10
 #define REG_BUSY_READY        BIT(0)
 #define REG_UNK2            0x400
+#define REG_QUEUE_CONTROL   0x404
 #define REG_CMD             0x408
 #define REG_QUEUE           0x410
 #define REG_NEXT_DEVICE     0x420
@@ -127,6 +129,11 @@
     case REG_UNK2:
         ret = 0x1;
         break;
+    case REG_QUEUE_CONTROL:
+        if (devid == DEVID_USB) {
+            ret = s->usb_queue_control;
+        }
+        break;
     case REG_UNK3:
         ret = 0x0;
         break;
@@ -300,6 +307,9 @@
 {
     VMAppleBdifState *s = opaque;
     /* Include the 4-byte frame length; 128 KiB payload is not 128 KiB wire. */
+    if (!(s->usb_queue_control & 1)) {
+        return 0;
+    }
     return VUSB_MAX_FRAME - MIN(s->usb_input->len, VUSB_MAX_FRAME);
 }
 
@@ -368,6 +378,7 @@
          * descriptor. An open, empty queue must initially accept work;
          * after a descriptor is posted, flush completion still controls
          * readiness. Closed peers and rejected sends remain not-ready. */
+        s->usb_queue_control = event == CHR_EVENT_OPENED ? 1 : 0;
         if (event == CHR_EVENT_OPENED) {
             s->usb_tx_ready = true;
         }
@@ -377,6 +388,9 @@
 static void vusb_cmd(VMAppleBdifState *s, uint64_t gp_addr)
 {
     VUsbDesc desc;
+    if (!(s->usb_queue_control & 1)) {
+        return;
+    }
     /* Only the descriptor is required, not the candidate's 128-byte debug
      * dump. A valid 16-byte descriptor may end at the RAM boundary. */
     MemTxResult result = dma_memory_read(&address_space_memory, gp_addr,
@@ -428,6 +442,22 @@
     trace_bdif_write(offset, size, value);
 
     switch (offset & ~REG_DEVID_MASK) {
+    case REG_QUEUE_CONTROL:
+        if (devid == DEVID_USB) {
+            /* Original AVPBooter writes 1/3 on startup and 0 on teardown,
+             * then polls this register until zero. Previously the unmapped
+             * read returned all ones, stalling after its DFU reset callback.
+             * Only the observed USB control behavior is modeled here. */
+            uint32_t prior = s->usb_queue_control;
+            s->usb_queue_control = (uint32_t)value;
+            if (!(value & 1)) {
+                vusb_clear(s);
+            } else if (!(prior & 1)) {
+                s->usb_tx_ready = qemu_chr_fe_backend_open(&s->usbdev);
+                qemu_chr_fe_accept_input(&s->usbdev);
+            }
+        }
+        break;
     case REG_QUEUE:
         if (devid == DEVID_USB) {
             s->usb_queue = value;
@@ -499,6 +529,7 @@
     VMAppleBdifState *s = VMAPPLE_BDIF(obj);
     vusb_clear(s);
     s->usb_tx_ready = qemu_chr_fe_backend_open(&s->usbdev);
+    s->usb_queue_control = s->usb_tx_ready ? 1 : 0;
 }
 
