 {
     MachineClass *mc = MACHINE_CLASS(oc);
@@ -985,6 +1012,10 @@
                                    vmapple_get_pac_model, vmapple_set_pac_model);
     object_class_property_set_description(oc, "x-pac-software-model",
         "Experimental TCG HVC/PAC state model (default off); not Apple crypto");
+    object_class_property_add_bool(oc, "x-ctrr-model",
+                                   vmapple_get_ctrr_model, vmapple_set_ctrr_model);
+    object_class_property_set_description(oc, "x-ctrr-model",
+        "Opt-in normal CTRR guest-permission model; default off");
