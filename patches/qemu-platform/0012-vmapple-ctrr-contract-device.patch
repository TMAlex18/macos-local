diff --git a/hw/vmapple/ctrr.c b/hw/vmapple/ctrr.c
new file mode 100644
--- /dev/null
+++ b/hw/vmapple/ctrr.c
@@ -0,0 +1,356 @@
+/*
+ * Opt-in VMApple CTRR contract device.
+ *
+ * This is a normal QEMU guest-memory device model. It does not use host
+ * hypervisor APIs, does not patch firmware, and never reports a successful
+ * protection operation without installing its guest-physical overlay.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/bitops.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qemu/host-utils.h"
+#include "exec/cpu-common.h"
+#include "hw/core/sysbus.h"
+#include "hw/core/qdev-properties.h"
+#include "qapi/error.h"
+#include "system/memory.h"
+#include "system/address-spaces.h"
+#include "trace.h"
+
+#define TYPE_VMAPPLE_CTRR "vmapple-ctrr"
+OBJECT_DECLARE_SIMPLE_TYPE(VMAppleCtrrState, VMAPPLE_CTRR)
+
+#define CTRR_WINDOW 0x10000
+#define CTRR_RANGE_BASE 0x40
+#define CTRR_RANGE_STRIDE 0x20
+#define CTRR_RANGE_COUNT 16
+#define CTRR_LOCK BIT(0)
+#define CTRR_ENABLE BIT(1)
+#define CTRR_READ_ONLY BIT(2)
+#define CTRR_CONTROL_MASK (CTRR_LOCK | CTRR_ENABLE | CTRR_READ_ONLY)
+
+typedef struct VMAppleCtrrRange VMAppleCtrrRange;
+
+struct VMAppleCtrrRange {
+    MemoryRegion overlay;
+    struct VMAppleCtrrState *owner;
+    uint64_t lower;
+    uint64_t upper;
+    uint32_t control;
+    uint64_t service_status;
+    bool mapped;
+};
+
+struct VMAppleCtrrState {
+    SysBusDevice parent_obj;
+    MemoryRegion regs;
+    MemoryRegion *system_memory;
+    MemoryRegion *ram;
+    uint64_t ram_base;
+    uint64_t ram_size;
+    uint32_t page_size;
+    uint32_t global_state;
+    VMAppleCtrrRange ranges[CTRR_RANGE_COUNT];
+};
+
+static bool ctrr_enabled(const VMAppleCtrrRange *r)
+{
+    return r->control & CTRR_ENABLE;
+}
+
+static bool ctrr_locked(const VMAppleCtrrRange *r)
+{
+    return r->control & CTRR_LOCK;
+}
+
+static bool ctrr_ram_contains(VMAppleCtrrState *s, uint64_t lower, uint64_t upper)
+{
+    return lower >= s->ram_base && upper >= lower &&
+           upper <= s->ram_base + s->ram_size - s->page_size;
+}
+
+static bool ctrr_aligned(VMAppleCtrrState *s, uint64_t value)
+{
+    return !(value & (s->page_size - 1));
+}
+
+static bool ctrr_overlaps(VMAppleCtrrState *s, unsigned index,
+                          uint64_t lower, uint64_t upper)
+{
+    for (unsigned i = 0; i < CTRR_RANGE_COUNT; i++) {
+        const VMAppleCtrrRange *other = &s->ranges[i];
+        if (i == index || !ctrr_enabled(other)) {
+            continue;
+        }
+        if (!(upper < other->lower || lower > other->upper)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void ctrr_overlay_disable(VMAppleCtrrRange *r)
+{
+    if (r->mapped) {
+        memory_region_del_subregion(r->owner->system_memory, &r->overlay);
+        r->mapped = false;
+    }
+}
+
+static void ctrr_overlay_enable(VMAppleCtrrRange *r)
+{
+    VMAppleCtrrState *s = r->owner;
+    uint64_t size = r->upper - r->lower + s->page_size;
+
+    ctrr_overlay_disable(r);
+    memory_region_set_size(&r->overlay, size);
+    memory_region_add_subregion_overlap(s->system_memory, r->lower,
+                                        &r->overlay, 10);
+    r->mapped = true;
+}
+
+static MemTxResult ctrr_overlay_read(void *opaque, hwaddr offset,
+                                     uint64_t *data, unsigned size,
+                                     MemTxAttrs attrs)
+{
+    VMAppleCtrrRange *r = opaque;
+    VMAppleCtrrState *s = r->owner;
+    uint8_t *ram;
+    uint64_t raw = 0;
+
+    if (!s->ram || size == 0 || size > 8 ||
+        r->lower + offset < s->ram_base ||
+        r->lower + offset + size > s->ram_base + s->ram_size) {
+        return MEMTX_ERROR;
+    }
+    ram = memory_region_get_ram_ptr(s->ram);
+    memcpy(&raw, ram + (r->lower - s->ram_base) + offset, size);
+    *data = le64_to_cpu(raw);
+    trace_vmapple_ctrr_overlay_read(r->lower + offset, size, *data);
+    return MEMTX_OK;
+}
+
+static MemTxResult ctrr_overlay_write(void *opaque, hwaddr offset,
+                                      uint64_t data, unsigned size,
+                                      MemTxAttrs attrs)
+{
+    VMAppleCtrrRange *r = opaque;
+    VMAppleCtrrState *s = r->owner;
+    uint8_t *ram;
+    uint64_t raw;
+
+    if (r->control & CTRR_READ_ONLY) {
+        trace_vmapple_ctrr_write_fault(r->lower + offset, size);
+        return MEMTX_ERROR;
+    }
+    if (!s->ram || size == 0 || size > 8 ||
+        r->lower + offset < s->ram_base ||
+        r->lower + offset + size > s->ram_base + s->ram_size) {
+        return MEMTX_ERROR;
+    }
+    raw = cpu_to_le64(data);
+    ram = memory_region_get_ram_ptr(s->ram);
+    memcpy(ram + (r->lower - s->ram_base) + offset, &raw, size);
+    return MEMTX_OK;
+}
+
+static const MemoryRegionOps ctrr_overlay_ops = {
+    .read_with_attrs = ctrr_overlay_read,
+    .write_with_attrs = ctrr_overlay_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 8,
+};
+
+static bool ctrr_validate_enable(VMAppleCtrrState *s, unsigned index,
+                                 uint64_t lower, uint64_t upper)
+{
+    return ctrr_aligned(s, lower) && ctrr_aligned(s, upper) &&
+           ctrr_ram_contains(s, lower, upper) &&
+           !ctrr_overlaps(s, index, lower, upper);
+}
+
+static MemTxResult ctrr_write_control(VMAppleCtrrState *s, unsigned index,
+                                      uint32_t value)
+{
+    VMAppleCtrrRange *r = &s->ranges[index];
+
+    if (value & ~CTRR_CONTROL_MASK || ctrr_locked(r)) {
+        return MEMTX_OK;
+    }
+    if (ctrr_enabled(r) && (value & CTRR_ENABLE)) {
+        /* Native active-update path only adds LOCK; permission stays fixed. */
+        r->control = (r->control & CTRR_READ_ONLY) | CTRR_ENABLE |
+                     (value & CTRR_LOCK);
+        return MEMTX_OK;
+    }
+    if (!(value & CTRR_ENABLE)) {
+        if (ctrr_enabled(r)) {
+            ctrr_overlay_disable(r);
+        }
+        r->control = value & CTRR_LOCK;
+        r->service_status = 0;
+        return MEMTX_OK;
+    }
+    if (!ctrr_validate_enable(s, index, r->lower, r->upper)) {
+        return MEMTX_ERROR;
+    }
+    r->control = value;
+    r->service_status = value;
+    ctrr_overlay_enable(r);
+    trace_vmapple_ctrr_enable(index, r->lower, r->upper, value);
+    return MEMTX_OK;
+}
+
+static MemTxResult ctrr_read(void *opaque, hwaddr offset, uint64_t *data,
+                             unsigned size, MemTxAttrs attrs)
+{
+    VMAppleCtrrState *s = opaque;
+    unsigned index;
+    uint64_t field;
+
+    *data = 0;
+    if (offset == 0x00) *data = 0x63747272;
+    else if (offset == 0x04) *data = 1;
+    else if (offset == 0x08) *data = s->global_state;
+    else if (offset == 0x0c) *data = CTRR_RANGE_COUNT;
+    else if (offset == 0x10) *data = ctz32(s->page_size);
+    else if (offset == 0x20 || offset == 0x24) {
+        uint64_t value = s->ram_base;
+        *data = (value >> ((offset - 0x20) * 8)) & (size == 4 ? UINT64_C(0xffffffff) : UINT64_MAX);
+    } else if (offset == 0x28 || offset == 0x2c) {
+        uint64_t value = s->ram_base + s->ram_size - s->page_size;
+        *data = (value >> ((offset - 0x28) * 8)) & (size == 4 ? UINT64_C(0xffffffff) : UINT64_MAX);
+    }
+    else if (offset >= CTRR_RANGE_BASE &&
+             offset < CTRR_RANGE_BASE + CTRR_RANGE_COUNT * CTRR_RANGE_STRIDE) {
+        index = (offset - CTRR_RANGE_BASE) / CTRR_RANGE_STRIDE;
+        field = (offset - CTRR_RANGE_BASE) % CTRR_RANGE_STRIDE;
+        if (field == 0) *data = s->ranges[index].lower;
+        else if (field == 8) *data = s->ranges[index].upper;
+        else if (field == 16) {
+            *data = s->ranges[index].service_status
+                ? s->ranges[index].service_status : s->ranges[index].control;
+        }
+    }
+    trace_vmapple_ctrr_reg_read(offset, size, *data);
+    return MEMTX_OK;
+}
+
+static MemTxResult ctrr_write(void *opaque, hwaddr offset, uint64_t value,
+                              unsigned size, MemTxAttrs attrs)
+{
+    VMAppleCtrrState *s = opaque;
+    unsigned index;
+    uint64_t field;
+
+    if (offset < CTRR_RANGE_BASE ||
+        offset >= CTRR_RANGE_BASE + CTRR_RANGE_COUNT * CTRR_RANGE_STRIDE) {
+        trace_vmapple_ctrr_reg_write(offset, size, value, MEMTX_OK);
+        return MEMTX_OK;
+    }
+    index = (offset - CTRR_RANGE_BASE) / CTRR_RANGE_STRIDE;
+    field = (offset - CTRR_RANGE_BASE) % CTRR_RANGE_STRIDE;
+    if (field == 0 || field == 8) {
+        VMAppleCtrrRange *r = &s->ranges[index];
+        if (!ctrr_locked(r) && !ctrr_enabled(r)) {
+            if (field == 0) r->lower = value;
+            else r->upper = value;
+            if (r->lower && r->upper && r->upper >= r->lower &&
+                ctrr_aligned(s, r->lower) && ctrr_aligned(s, r->upper)) {
+                /* The normal SVC boundary service reports RWX status (7)
+                 * before the following status readback. */
+                r->service_status = 7;
+                trace_vmapple_ctrr_service_status(index, r->service_status);
+            }
+        }
+        trace_vmapple_ctrr_reg_write(offset, size, value, MEMTX_OK);
+        return MEMTX_OK;
+    }
+    if (field == 16) {
+        MemTxResult result = ctrr_write_control(s, index, value & 0xffffffffu);
+        trace_vmapple_ctrr_reg_write(offset, size, value, result);
+        return result;
+    }
+    trace_vmapple_ctrr_reg_write(offset, size, value, MEMTX_OK);
+    return MEMTX_OK;
+}
+
+static const MemoryRegionOps ctrr_regs_ops = {
+    .read_with_attrs = ctrr_read,
+    .write_with_attrs = ctrr_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 8,
+};
+
+static void ctrr_reset(Object *obj, ResetType type)
+{
+    VMAppleCtrrState *s = VMAPPLE_CTRR(obj);
+    for (unsigned i = 0; i < CTRR_RANGE_COUNT; i++) {
+        ctrr_overlay_disable(&s->ranges[i]);
+        s->ranges[i].lower = s->ranges[i].upper = 0;
+        s->ranges[i].control = 0;
+        s->ranges[i].service_status = 0;
+    }
+    s->global_state = 0;
+}
+
+static void ctrr_init(Object *obj)
+{
+    VMAppleCtrrState *s = VMAPPLE_CTRR(obj);
+    memory_region_init_io(&s->regs, obj, &ctrr_regs_ops, s,
+                          "VMApple CTRR", CTRR_WINDOW);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->regs);
+    for (unsigned i = 0; i < CTRR_RANGE_COUNT; i++) {
+        VMAppleCtrrRange *r = &s->ranges[i];
+        r->owner = s;
+        memory_region_init_io(&r->overlay, obj, &ctrr_overlay_ops, r,
+                              "VMApple CTRR protected range", 1);
+    }
+}
+
+static void ctrr_realize(DeviceState *dev, Error **errp)
+{
+    VMAppleCtrrState *s = VMAPPLE_CTRR(dev);
+    if (!s->ram || !s->ram_size) {
+        error_setg(errp, "CTRR contract model requires the VM RAM link");
+        return;
+    }
+    s->page_size = qemu_real_host_page_size();
+    s->system_memory = get_system_memory();
+}
+
+static const Property ctrr_properties[] = {
+    DEFINE_PROP_LINK("ram", VMAppleCtrrState, ram, TYPE_MEMORY_REGION,
+                     MemoryRegion *),
+    DEFINE_PROP_UINT64("ram-base", VMAppleCtrrState, ram_base, 0x70000000),
+    DEFINE_PROP_UINT64("ram-size", VMAppleCtrrState, ram_size, 0),
+};
+
+static void ctrr_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+    device_class_set_props(dc, ctrr_properties);
+    dc->realize = ctrr_realize;
+    rc->phases.hold = ctrr_reset;
+    dc->desc = "VMApple CTRR contract device";
+}
+
+static const TypeInfo ctrr_type = {
+    .name = TYPE_VMAPPLE_CTRR,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(VMAppleCtrrState),
+    .instance_init = ctrr_init,
+    .class_init = ctrr_class_init,
+};
+
+static void ctrr_register_types(void)
+{
+    type_register_static(&ctrr_type);
+}
+type_init(ctrr_register_types)
