     create_cfg(vms, sysmem, &error_fatal);
+    if (vms->ctrr_model) {
+        create_ctrr(vms, machine, &error_fatal);
+    }
 
     /* connect powerdown request */
     vms->powerdown_notifier.notify = vmapple_powerdown_req;
@@ -977,6 +994,16 @@
