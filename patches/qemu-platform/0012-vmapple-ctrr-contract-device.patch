 }
 
+static bool vmapple_get_ctrr_model(Object *obj, Error **errp)
+{
+    return VMAPPLE_MACHINE(obj)->ctrr_model;
+}
+
+static void vmapple_set_ctrr_model(Object *obj, bool value, Error **errp)
+{
+    VMAPPLE_MACHINE(obj)->ctrr_model = value;
+}
+
