+static void create_ctrr(VMAppleMachineState *vms, MachineState *machine,
+                        Error **errp)
+{
+    DeviceState *dev = qdev_new(TYPE_VMAPPLE_CTRR);
+
+    object_property_set_link(OBJECT(dev), "ram", OBJECT(machine->ram),
+                             &error_abort);
+    qdev_prop_set_uint64(dev, "ram-base", vms->memmap[VMAPPLE_MEM].base);
+    qdev_prop_set_uint64(dev, "ram-size", machine->ram_size);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), errp);
+    sysbus_mmio_map(SYS_BUS_DEVICE(dev), 0, 0x30260000);
+}
+
 static void create_gfx(VMAppleMachineState *vms, MemoryRegion *mem)
 {
     int irq_gfx = vms->irqmap[VMAPPLE_APV_GFX];
@@ -874,6 +888,9 @@
 
