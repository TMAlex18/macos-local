diff --git a/include/system/memory.h b/include/system/memory.h
index a7e03fc3e7..60df2f6566 100644
--- a/include/system/memory.h
+++ b/include/system/memory.h
@@ -1428,6 +1428,33 @@ bool memory_region_init_rom_device(MemoryRegion *mr,
                                    uint64_t size,
                                    Error **errp);
 
+/**
+ * memory_region_init_rom_device_shared: ROMD view of an existing RAM region
+ *
+ * Reads and instruction fetches use @backing's original RAMBlock and host
+ * bytes. Ordinary writes call @ops. No RAM is allocated/copied or registered
+ * for migration a second time. The backing owner is retained when distinct
+ * from @owner; finalization only releases that reference, never the RAMBlock.
+ *
+ * @backing must be an original, non-alias RAM region. Its size/lifetime must
+ * not be changed independently while the view exists. Map portions of this
+ * full-sized view with ordinary aliases. Debug/ROM-loading writes retain the
+ * standard privileged QEMU ROMD behavior; this is not a host-debug boundary.
+ *
+ * @mr: destination region
+ * @owner: object owning the view
+ * @ops: device callbacks for ordinary writes and non-ROMD reads
+ * @opaque: callback state
+ * @name: view name
+ * @backing: existing RAM region
+ * @errp: error output
+ * Return: true on success
+ */
+bool memory_region_init_rom_device_shared(MemoryRegion *mr, Object *owner,
+                                          const MemoryRegionOps *ops,
+                                          void *opaque, const char *name,
+                                          MemoryRegion *backing, Error **errp);
+
 
 /**
  * memory_region_owner: get a memory region's owner.
diff --git a/system/memory.c b/system/memory.c
index 264dc90c0a..9751e1b237 100644
--- a/system/memory.c
+++ b/system/memory.c
@@ -1182,6 +1182,14 @@ static void memory_region_destructor_ram(MemoryRegion *mr)
     qemu_ram_free(mr->ram_block);
 }
 
+static void memory_region_destructor_rom_device_shared(MemoryRegion *mr)
+{
+    MemoryRegion *backing = mr->ram_block->mr;
+
+    mr->ram_block = NULL;
+    memory_region_unref(backing);
+}
+
 static bool memory_region_need_escape(char c)
 {
     return c == '/' || c == '[' || c == '\\' || c == ']';
@@ -3635,6 +3643,34 @@ bool memory_region_init_rom_device(MemoryRegion *mr, Object *owner,
     return false;
 }
 
+bool memory_region_init_rom_device_shared(MemoryRegion *mr, Object *owner,
+                                          const MemoryRegionOps *ops,
+                                          void *opaque, const char *name,
+                                          MemoryRegion *backing, Error **errp)
+{
+    if (!backing || !memory_region_is_ram(backing) || backing->alias ||
+        !backing->ram_block || backing->ram_block->mr != backing) {
+        error_setg(errp, "Shared ROM device requires an original RAM region");
+        return false;
+    }
+    assert(ops);
+    memory_region_init_io(mr, owner, ops, opaque, name,
+                          memory_region_size(backing));
+    /*
+     * A second RAMBlock for the same host pointer would give TCG competing
+     * physical TB identities. Borrow the original block, including its dirty
+     * tracking/SMC identity, without another allocation or migration entry.
+     * Keep ram=false: ROMD reads are direct, but ordinary writes must call ops.
+     */
+    if (backing->owner != mr->owner) {
+        memory_region_ref(backing);
+        mr->destructor = memory_region_destructor_rom_device_shared;
+    }
+    mr->ram_block = backing->ram_block;
+    mr->rom_device = true;
+    return true;
+}
