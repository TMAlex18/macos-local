-           likely(((uintptr_t)pc + entry->addend) == expected_host_pc);
+    TranslationBlock *tb = qatomic_read(&w->tb);
+
+    if (likely(tb &&
+               w->pc == s->pc &&
+               w->host_pc != 0 &&
