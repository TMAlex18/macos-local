diff --git a/accel/tcg/tb-hash.h b/accel/tcg/tb-hash.h
index dde52fc..0a74bf3 100644
--- a/accel/tcg/tb-hash.h
+++ b/accel/tcg/tb-hash.h
@@ -34,7 +34,7 @@
 #define TB_JMP_PAGE_BITS 6
 #define TB_JMP_PAGE_SIZE (1 << TB_JMP_PAGE_BITS)
 #define TB_JMP_ADDR_MASK (TB_JMP_PAGE_SIZE - 1)
-#define TB_JMP_PAGE_MASK (TB_JMP_CACHE_SIZE - TB_JMP_PAGE_SIZE)
+#define TB_JMP_PAGE_MASK (TB_JMP_CACHE_SETS - TB_JMP_PAGE_SIZE)
 
 static inline unsigned int tb_jmp_cache_hash_page(vaddr pc)
 {
@@ -49,9 +49,22 @@ static inline unsigned int tb_jmp_cache_hash_offset(vaddr pc)
     return ((ofs >> 2) ^ (ofs >> 8) ^ ofs) & TB_JMP_ADDR_MASK;
 }
 
+static inline unsigned int tb_jmp_cache_hash_func_mask(vaddr pc,
+                                                       uint32_t page_bits,
+                                                       vaddr page_mask)
+{
+    vaddr vpn = pc >> page_bits;
+    vaddr ofs = pc & ~page_mask;
+    unsigned int p = ((vpn ^ (vpn >> 8) ^ (vpn >> 16)) << TB_JMP_PAGE_BITS)
+                     & TB_JMP_PAGE_MASK;
+    unsigned int o = ((ofs >> 2) ^ (ofs >> 8) ^ ofs) & TB_JMP_ADDR_MASK;
+
+    return p | o;
+}
+
 static inline unsigned int tb_jmp_cache_hash_func(vaddr pc)
 {
-    return tb_jmp_cache_hash_page(pc) | tb_jmp_cache_hash_offset(pc);
+    return tb_jmp_cache_hash_func_mask(pc, TARGET_PAGE_BITS, TARGET_PAGE_MASK);
 }
 
 #else
@@ -59,7 +72,7 @@ static inline unsigned int tb_jmp_cache_hash_func(vaddr pc)
 /* In user-mode we can get better hashing because we do not have a TLB */
 static inline unsigned int tb_jmp_cache_hash_func(vaddr pc)
 {
-    return (pc ^ (pc >> TB_JMP_CACHE_BITS)) & (TB_JMP_CACHE_SIZE - 1);
+    return (pc ^ (pc >> TB_JMP_CACHE_BITS)) & (TB_JMP_CACHE_SETS - 1);
 }
 
