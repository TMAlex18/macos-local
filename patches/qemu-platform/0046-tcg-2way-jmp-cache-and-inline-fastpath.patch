+#define TB_JMP_CACHE_BITS 13
+#define TB_JMP_CACHE_SETS (1 << TB_JMP_CACHE_BITS)
+#define TB_JMP_CACHE_WAYS 2
+#define TB_JMP_CACHE_SIZE (TB_JMP_CACHE_SETS * TB_JMP_CACHE_WAYS)
 
 /*
  * Invalidated in parallel; all accesses to 'tb' must be atomic.
@@ -21,14 +23,30 @@
  * no need for qatomic_rcu_read() and pc is always consistent with a
  * non-NULL value of 'tb'.  Strictly speaking pc is only needed for
  * CF_PCREL, but it's used always for simplicity.
+ *
+ * Each 2-way set occupies exactly one 64-byte cache line; way[0].lru
+ * selects the replacement victim (0 or 1) within the set.
  */
+typedef struct CPUJumpCacheWay {
+    TranslationBlock *tb;
+    vaddr pc;
+    uintptr_t host_pc;
+    uint8_t mmu_idx;
+    uint8_t lru;
+    uint8_t pad[6];
+} CPUJumpCacheWay;
+
+typedef struct CPUJumpCacheSet {
+    CPUJumpCacheWay way[TB_JMP_CACHE_WAYS];
+} CPUJumpCacheSet;
+
+QEMU_BUILD_BUG_ON(sizeof(CPUJumpCacheWay) != 32);
+QEMU_BUILD_BUG_ON(sizeof(CPUJumpCacheSet) != 64);
+
 typedef struct CPUJumpCache {
     struct rcu_head rcu;
-    struct {
-        TranslationBlock *tb;
-        vaddr pc;
-        uintptr_t host_pc;
-    } array[TB_JMP_CACHE_SIZE];
+    uint8_t head_pad[64 - sizeof(struct rcu_head)];
+    CPUJumpCacheSet sets[TB_JMP_CACHE_SETS];
 } CPUJumpCache;
 
 #endif /* ACCEL_TCG_TB_JMP_CACHE_H */
