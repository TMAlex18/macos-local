+static G_NO_INLINE TranslationBlock *
+tb_lookup_slow(CPUState *cpu, const TCGTBCPUState *s, CPUJumpCacheSet *set)
+{
+    void *host_pc = NULL;
+    tb_page_addr_t phys_pc;
+    TranslationBlock *tb;
+
+    phys_pc = get_page_addr_code_hostp(cpu_env(cpu), s->pc, &host_pc);
+    if (unlikely(phys_pc == -1)) {
+        return NULL;
+    }
+
+    uint8_t mmu_idx = (uint8_t)cpu_mmu_index(cpu, true);
+    for (int i = 0; i < TB_JMP_CACHE_WAYS; i++) {
+        CPUJumpCacheWay *w = &set->way[i];
+        tb = qatomic_read(&w->tb);
+        if (tb &&
+            w->pc == s->pc &&
+            tb->cs_base == s->cs_base &&
+            tb->flags == s->flags &&
+            tb_cflags(tb) == s->cflags &&
+            tb_page_addr1(tb) == -1 &&
+            tb_page_addr0(tb) == phys_pc) {
+            w->host_pc = (uintptr_t)host_pc;
+            w->mmu_idx = mmu_idx;
+            set->way[0].lru = (i == 0) ? 1 : 0;
+            assert((tb_cflags(tb) & CF_PCREL) || tb->pc == s->pc);
+            return tb;
+        }
+    }
+
+    tb = tb_htable_lookup_phys(cpu, s, phys_pc);
+    if (tb == NULL) {
+        return NULL;
+    }
+
+    if (likely(tb_page_addr1(tb) == -1 && host_pc != NULL &&
+               !(tb_cflags(tb) & CF_INVALID))) {
+        int victim = (qatomic_read(&set->way[0].tb) == NULL) ? 0
+                     : (qatomic_read(&set->way[1].tb) == NULL) ? 1
+                     : (set->way[0].lru & 1);
+        CPUJumpCacheWay *w = &set->way[victim];
+
+        qatomic_set(&w->tb, NULL);
+        w->pc = s->pc;
+        w->host_pc = (uintptr_t)host_pc;
+        w->mmu_idx = mmu_idx;
+        set->way[0].lru = (victim == 0) ? 1 : 0;
+        qatomic_store_release(&w->tb, tb);
+    }
+
+    assert((tb_cflags(tb) & CF_PCREL) || tb->pc == s->pc);
+    return tb;
+}
 #endif
 
