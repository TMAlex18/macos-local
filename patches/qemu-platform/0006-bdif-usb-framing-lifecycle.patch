+static void vusb_flush_tx(VMAppleBdifState *s)
+{
+    if (!qemu_chr_fe_backend_open(&s->usbdev)) {
+        g_byte_array_set_size(s->usb_output, 0);
+        s->usb_tx_ready = false;
+        return;
+    }
+    while (s->usb_output->len) {
+        int sent = qemu_chr_fe_write(&s->usbdev, s->usb_output->data,
+                                     s->usb_output->len);
+        if (sent <= 0) {
+            if (sent < 0 && errno != EAGAIN && errno != EWOULDBLOCK) {
+                qemu_chr_fe_disconnect(&s->usbdev);
+                return;
+            }
+            if (!s->usb_tx_watch) {
+                s->usb_tx_watch = qemu_chr_fe_add_watch(&s->usbdev,
+                              G_IO_OUT | G_IO_HUP, vusb_tx_callback, s);
+            }
+            return;
+        }
+        g_byte_array_remove_range(s->usb_output, 0, sent);
+    }
+    s->usb_tx_ready = true;
+}
+
+static gboolean vusb_tx_callback(void *channel, GIOCondition condition,
+                                 void *opaque)
+{
+    VMAppleBdifState *s = opaque;
+    s->usb_tx_watch = 0;
+    if (condition & G_IO_HUP) {
+        g_byte_array_set_size(s->usb_output, 0);
+        s->usb_tx_ready = false;
+    } else {
+        vusb_flush_tx(s);
+    }
+    return G_SOURCE_REMOVE;
+}
