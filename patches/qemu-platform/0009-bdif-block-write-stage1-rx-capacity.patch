@@ -507,6 +536,25 @@
 static void bdif_realize(DeviceState *dev, Error **errp)
 {
     VMAppleBdifState *s = VMAPPLE_BDIF(dev);
+    BlockBackend *backends[] = { s->aux, s->root };
+
+    /* Request the permissions that the emulated device actually uses.
+     * Respect a read-only backend and retain its existing sharing contract. */
+    for (size_t i = 0; i < ARRAY_SIZE(backends); i++) {
+        BlockBackend *blk = backends[i];
+        uint64_t perm, shared_perm;
+        if (!blk) {
+            continue;
+        }
+        blk_get_perm(blk, &perm, &shared_perm);
+        perm |= BLK_PERM_CONSISTENT_READ;
+        if (blk_supports_write_perm(blk)) {
+            perm |= BLK_PERM_WRITE;
+        }
+        if (blk_set_perm(blk, perm, shared_perm, errp) < 0) {
+            return;
+        }
+    }
 
     if (qemu_chr_fe_backend_connected(&s->usbdev)) {
         qemu_chr_fe_set_handlers(&s->usbdev, vusb_can_receive, vusb_receive,
