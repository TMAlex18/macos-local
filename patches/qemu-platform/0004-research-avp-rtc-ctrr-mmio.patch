+/*
+ * Experimental unmapped AVP register bank placeholders. An earlier
+ * macOS/HVF VMApple research RFC reported early boot probes at
+ * 0x30240000 and 0x30260000; zero reads and ignored writes were used
+ * there as compatibility placeholders. Their full hardware semantics
+ * are NOT established, especially for macOS 27.
+ *
+ * Keep these off by default, explicitly opt in for tracing/bringup only.
+ * No AVP sealed-register bank is added without behavioral evidence.
+ */
+static uint64_t vmapple_avp_research_read(void *opaque, hwaddr offset,
+                                         unsigned size)
+{
+    VMappleExperimentalMMIO *dev = opaque;
+    dev->reads++;
+    qemu_log_mask(LOG_UNIMP, "experimental VMApple %s READ+0x%" HWADDR_PRIx
+                  " width=%u (return 0)\n", dev->name, offset, size);
+    return 0;
+}
+
+static void vmapple_avp_research_write(void *opaque, hwaddr offset,
+                                      uint64_t value, unsigned size)
+{
+    VMappleExperimentalMMIO *dev = opaque;
+    dev->writes++;
+    qemu_log_mask(LOG_UNIMP, "experimental VMApple %s WRITE+0x%" HWADDR_PRIx
+                  " value=0x%" PRIx64 " width=%u (ignored)\n",
+                  dev->name, offset, value, size);
+}
+
+static const MemoryRegionOps vmapple_avp_research_ops = {
+    .read = vmapple_avp_research_read,
+    .write = vmapple_avp_research_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 1,
+        .max_access_size = 8,
+    },
+};
+
+static void vmapple_avp_research_init(VMAppleMachineState *vms,
+                                     MemoryRegion *sysmem)
+{
+    VMappleExperimentalMMIO *rtc = &vms->avp_rtc;
+    VMappleExperimentalMMIO *ctrr = &vms->avp_ctrr;
+
+    rtc->name = "avp-rtc";
+    memory_region_init_io(&rtc->mr, OBJECT(vms), &vmapple_avp_research_ops,
+                          rtc, "x-vmapple-avp-rtc", 0x1000);
+    memory_region_add_subregion(sysmem, 0x30240000, &rtc->mr);
+
+    ctrr->name = "avp-ctrr";
+    memory_region_init_io(&ctrr->mr, OBJECT(vms), &vmapple_avp_research_ops,
+                          ctrr, "x-vmapple-avp-ctrr", 0x10000);
+    memory_region_add_subregion(sysmem, 0x30260000, &ctrr->mr);
+}
+
