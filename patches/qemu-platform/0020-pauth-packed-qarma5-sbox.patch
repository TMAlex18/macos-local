From: macos-local PAuth cost research
Subject: [PATCH] Apply QARMA5 substitutions with packed Boolean bit planes
Base-After: 0019-opt-in-ascending-pci-capabilities.patch

Evaluate the original forward/inverse 4-bit truth tables across sixteen
independent cells using four bit planes. Fixed Boolean expressions replace the
per-cell lookup loops. Keep QARMA3's sigma1, round structure, shuffles,
keys, authentication and algorithm selection unchanged.

diff --git a/target/arm/tcg/pauth_helper.c b/target/arm/tcg/pauth_helper.c
--- a/target/arm/tcg/pauth_helper.c
+++ b/target/arm/tcg/pauth_helper.c
@@ -84,17 +84,19 @@
 
 static uint64_t pac_sub(uint64_t i)
 {
-    static const uint8_t sub[16] = {
-        0xb, 0x6, 0x8, 0xf, 0xc, 0x0, 0x9, 0xe,
-        0x3, 0x7, 0x4, 0x5, 0xd, 0x2, 0x1, 0xa,
-    };
-    uint64_t o = 0;
-    int b;
-
-    for (b = 0; b < 64; b += 4) {
-        o |= (uint64_t)sub[(i >> b) & 0xf] << b;
-    }
-    return o;
+    const uint64_t m = UINT64_C(0x1111111111111111);
+    /* Align bits 0 through 3 of every cell into independent bit planes. */
+    uint64_t a = i & m, b = (i >> 1) & m;
+    uint64_t c = (i >> 2) & m, d = (i >> 3) & m;
+    uint64_t u = a ^ c, v = a & c, w = d & u;
+
+    /* Factored Boolean form of { b,6,8,f,c,0,9,e,3,7,4,5,d,2,1,a }. */
+    uint64_t o0 = m ^ u ^ b ^ (~b & (v ^ w));
+    uint64_t o1 = m ^ b ^ c ^ (b & u) ^ ((a & d) & (b ^ c));
+    uint64_t o2 = u ^ (b & (c ^ d ^ w));
+    uint64_t o3 = m ^ a ^ d ^ (a & b) ^ (d & ((u & ~b) ^ v));
+
+    return o0 | (o1 << 1) | (o2 << 2) | (o3 << 3);
 }
 
 static uint64_t pac_sub1(uint64_t i)
@@ -114,17 +116,18 @@
 
 static uint64_t pac_inv_sub(uint64_t i)
 {
-    static const uint8_t inv_sub[16] = {
-        0x5, 0xe, 0xd, 0x8, 0xa, 0xb, 0x1, 0x9,
-        0x2, 0x6, 0xf, 0x0, 0x4, 0xc, 0x7, 0x3,
-    };
-    uint64_t o = 0;
-    int b;
-
-    for (b = 0; b < 64; b += 4) {
-        o |= (uint64_t)inv_sub[(i >> b) & 0xf] << b;
-    }
-    return o;
+    const uint64_t m = UINT64_C(0x1111111111111111);
+    uint64_t a = i & m, b = (i >> 1) & m;
+    uint64_t c = (i >> 2) & m, d = (i >> 3) & m;
+    uint64_t u = a ^ c, v = a | c, w = c & ~a;
+
+    /* Factored Boolean form of { 5,e,d,8,a,b,1,9,2,6,f,0,4,c,7,3 }. */
+    uint64_t o0 = m ^ u ^ (b & w) ^ (d & ~(b | u));
+    uint64_t o1 = (v & ~b) ^ (d & ~(a & ~c));
+    uint64_t o2 = o0 ^ a ^ (b & u) ^ (d & w);
+    uint64_t o3 = v ^ (b & ~a) ^ (d & (u ^ (b & c)));
+
+    return o0 | (o1 << 1) | (o2 << 2) | (o3 << 3);
 }
 
 static uint64_t pac_mult(uint64_t i)
