diff --git a/target/arm/gtimer-exact.h b/target/arm/gtimer-exact.h
new file mode 100644
--- /dev/null
+++ b/target/arm/gtimer-exact.h
@@ -0,0 +1,53 @@
+/* Exact ARM generic-timer tick/ns conversions for an opt-in TCG experiment.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Bounds: 1 <= hz <= 1,000,000,000; non-negative QEMU virtual time.
+ * Quotient/remainder arithmetic avoids floating point and multiplication
+ * overflow. Deadline conversion rounds upward: the selected tick must have
+ * arrived at callback time, not one nanosecond later.
+ */
+#ifndef ARM_GTIMER_EXACT_H
+#define ARM_GTIMER_EXACT_H
+#include <stdbool.h>
+#include <stdint.h>
+#include <limits.h>
+
+static inline uint64_t arm_gt_exact_ticks(uint64_t ns, uint32_t hz)
+{
+    return (ns / UINT64_C(1000000000)) * hz +
+           ((ns % UINT64_C(1000000000)) * hz) / UINT64_C(1000000000);
+}
+
+static inline int64_t arm_gt_exact_deadline_ns(uint64_t tick, uint32_t hz)
+{
+    uint64_t sec = tick / hz;
+    uint64_t rem = tick % hz;
+    uint64_t ns, fraction;
+    if (sec > INT64_MAX / UINT64_C(1000000000)) {
+        return INT64_MAX;
+    }
+    ns = sec * UINT64_C(1000000000);
+    fraction = (rem * UINT64_C(1000000000) + hz - 1) / hz;
+    if (fraction > (uint64_t)INT64_MAX - ns) {
+        return INT64_MAX;
+    }
+    return ns + fraction;
+}
+
+/* Return the next physical counter value that causes the requested edge
+ * in bit `bit` of the offset guest counter (EVNTDIR: 0=rising, 1=falling).
+ * The offset may wrap the guest counter; saturate physical-count overflow.
+ */
+static inline uint64_t arm_gt_exact_event_tick(uint64_t physical,
+                                              uint64_t offset,
+                                              unsigned bit, bool falling)
+{
+    uint64_t value = physical - offset;
+    uint64_t edge = UINT64_C(1) << bit;
+    uint64_t delta = edge - (value & (edge - 1));
+    if (((value & edge) != 0) ^ falling) {
+        delta += edge;
+    }
+    return delta > UINT64_MAX - physical ? UINT64_MAX : physical + delta;
+}
+#endif
