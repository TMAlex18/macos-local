+#ifdef ARM_PAUTH_HAVE_X86_SIMD
+    if (likely(arm_pauth_use_ssse3)) {
+        return qarma_ssse3_compute(data, modifier, key, isqarma3);
+    }
+#endif
+    return qarma_scalar_compute(data, modifier, key, isqarma3);
+}
