diff --git a/target/arm/helper.c b/target/arm/helper.c
--- a/target/arm/helper.c
+++ b/target/arm/helper.c
@@ -10302,6 +10302,39 @@
 ARMVAParameters aa64_pauth_va_parameters(CPUARMState *env, uint64_t va,
                                          ARMMMUIdx mmu_idx, bool data)
 {
+    if (likely(env->pauth_va_cache_enabled)) {
+        uint64_t tcr = regime_tcr(env, mmu_idx);
+        ARMPAuthVACacheSlot *slot = &env->pauth_va_cache[(unsigned)mmu_idx & 15];
+        unsigned select = extract64(va, 55, 1);
+
+        if (unlikely(!slot->valid || slot->mmu_idx != (uint32_t)mmu_idx ||
+                     slot->tcr != tcr)) {
+            ARMVAParameters i0 = aa64_va_parameters_impl(env, 0, mmu_idx,
+                                                         false, false, true);
+            ARMVAParameters i1 = aa64_va_parameters_impl(env, 1ULL << 55,
+                                                         mmu_idx, false,
+                                                         false, true);
+            ARMVAParameters d0 = aa64_va_parameters_impl(env, 0, mmu_idx,
+                                                         true, false, true);
+            ARMVAParameters d1 = aa64_va_parameters_impl(env, 1ULL << 55,
+                                                         mmu_idx, true,
+                                                         false, true);
+            slot->tcr = tcr;
+            slot->mmu_idx = (uint32_t)mmu_idx;
+            slot->tsz[0] = i0.tsz;
+            slot->tsz[1] = i1.tsz;
+            slot->tbi_mask = (i0.tbi & 1) | ((i1.tbi & 1) << 1) |
+                             ((d0.tbi & 1) << 2) | ((d1.tbi & 1) << 3);
+            slot->mtx_mask = (i0.mtx & 1) | ((i1.mtx & 1) << 1);
+            slot->valid = true;
+        }
+        return (ARMVAParameters) {
+            .tsz = slot->tsz[select],
+            .tbi = (slot->tbi_mask >> (data * 2 + select)) & 1,
+            .mtx = (slot->mtx_mask >> select) & 1,
+        };
+    }
+
     ARMVAParameters full = aa64_va_parameters_impl(env, va, mmu_idx,
                                                   data, false, true);
 
