From: macos-local research
Subject: [PATCH] Pass internal TCG lookup state by const pointer

Avoid copying the 24-byte lookup state through tb_lookup and
tb_htable_lookup. Each caller still owns its local state, including any
breakpoint cflags changes, and the QHT descriptor retains its own copy.
No cache key, comparison, atomic access, invalidation or page rule changes.
Local experiment, not intended for upstream submission.

diff --git a/accel/tcg/cpu-exec.c b/accel/tcg/cpu-exec.c
index 5b4bca5084..767eae2db2 100644
--- a/accel/tcg/cpu-exec.c
+++ b/accel/tcg/cpu-exec.c
@@ -195,56 +195,53 @@ static bool tb_lookup_cmp(const void *p, const void *d)
     return false;
 }
 
-static TranslationBlock *tb_htable_lookup(CPUState *cpu, TCGTBCPUState s)
+static TranslationBlock *tb_htable_lookup(CPUState *cpu, const TCGTBCPUState *s)
 {
     tb_page_addr_t phys_pc;
     struct tb_desc desc;
     uint32_t h;
 
-    desc.s = s;
+    desc.s = *s;
     desc.env = cpu_env(cpu);
-    phys_pc = get_page_addr_code(desc.env, s.pc);
+    phys_pc = get_page_addr_code(desc.env, s->pc);
     if (phys_pc == -1) {
         return NULL;
     }
     desc.page_addr0 = phys_pc;
-    h = tb_hash_func(phys_pc, (s.cflags & CF_PCREL ? 0 : s.pc),
-                     s.flags, s.cs_base, s.cflags);
+    h = tb_hash_func(phys_pc, (s->cflags & CF_PCREL ? 0 : s->pc),
+                     s->flags, s->cs_base, s->cflags);
     return qht_lookup_custom(&tb_ctx.htable, &desc, h, tb_lookup_cmp);
 }
 
