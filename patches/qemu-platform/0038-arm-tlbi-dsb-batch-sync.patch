diff --git a/accel/tcg/cputlb.c b/accel/tcg/cputlb.c
index 5923a12e40..cf8b008495 100644
--- a/accel/tcg/cputlb.c
+++ b/accel/tcg/cputlb.c
@@ -858,6 +858,185 @@ void tlb_flush_page_bits_by_mmuidx_all_cpus_synced(CPUState *src_cpu,
                                               idxmap, bits);
 }
 
+typedef struct TLBPeerBatch {
+    int refcount;
+    uint16_t full_idxmap;
+    uint16_t count;
+    struct {
+        vaddr addr;
+        vaddr len;
+        uint16_t idxmap;
+        uint16_t bits;
+    } ranges[];
+} TLBPeerBatch;
+
+static void tlb_flush_peer_batch_async(CPUState *cpu, run_on_cpu_data data)
+{
+    TLBPeerBatch *batch = data.host_ptr;
+
+    if (batch->full_idxmap) {
+        tlb_flush_by_mmuidx_async_work(cpu,
+                                       RUN_ON_CPU_HOST_INT(batch->full_idxmap));
+    }
+    for (unsigned i = 0; i < batch->count; i++) {
+        MMUIdxMap idxmap = batch->ranges[i].idxmap & ~batch->full_idxmap;
+        if (!idxmap) {
+            continue;
+        }
+        vaddr addr = batch->ranges[i].addr;
+        vaddr len = batch->ranges[i].len;
+        unsigned bits = batch->ranges[i].bits;
+        if (len <= TARGET_PAGE_SIZE && bits >= target_long_bits()) {
+            tlb_flush_page_by_mmuidx_async_0(cpu, addr, idxmap);
+        } else {
+            TLBFlushRangeData d = {
+                .addr = addr,
+                .len = len,
+                .idxmap = idxmap,
+                .bits = bits,
+            };
+            tlb_flush_range_by_mmuidx_async_0(cpu, d);
+        }
+    }
+    if (qatomic_fetch_dec(&batch->refcount) == 1) {
+        g_free(batch);
+    }
+}
+
+static void tlb_flush_sync_noop_async(CPUState *cpu, run_on_cpu_data data)
+{
+}
+
+static inline bool tlb_has_peer_cpus(const CPUState *src_cpu)
+{
+    return first_cpu != NULL &&
+           (first_cpu != src_cpu || CPU_NEXT(first_cpu) != NULL);
+}
+
+bool tlb_flush_by_mmuidx_all_cpus_deferred(CPUState *src_cpu, MMUIdxMap idxmap)
+{
+    tlb_flush_by_mmuidx(src_cpu, idxmap);
+    if (!tlb_has_peer_cpus(src_cpu)) {
+        return false;
+    }
+    src_cpu->tlb_deferred_peer.full_idxmap |= idxmap;
+    return true;
+}
+
+bool tlb_flush_range_by_mmuidx_all_cpus_deferred(CPUState *src_cpu,
+                                                 vaddr addr,
+                                                 vaddr len,
+                                                 MMUIdxMap idxmap,
+                                                 unsigned bits)
+{
+    if (bits < TARGET_PAGE_BITS) {
+        return tlb_flush_by_mmuidx_all_cpus_deferred(src_cpu, idxmap);
+    }
+
+    if (len <= TARGET_PAGE_SIZE && bits >= target_long_bits()) {
+        tlb_flush_page_by_mmuidx(src_cpu, addr, idxmap);
+    } else {
+        tlb_flush_range_by_mmuidx(src_cpu, addr, len, idxmap, bits);
+    }
+
+    if (!tlb_has_peer_cpus(src_cpu)) {
+        return false;
+    }
+
+    idxmap &= ~src_cpu->tlb_deferred_peer.full_idxmap;
+    if (!idxmap) {
+        return true;
+    }
+
+    uint16_t idx = src_cpu->tlb_deferred_peer.count;
+    if (idx < CPU_TLB_DEFERRED_BATCH_MAX) {
+        src_cpu->tlb_deferred_peer.ranges[idx].addr = addr & TARGET_PAGE_MASK;
+        src_cpu->tlb_deferred_peer.ranges[idx].len = len;
+        src_cpu->tlb_deferred_peer.ranges[idx].idxmap = idxmap;
+        src_cpu->tlb_deferred_peer.ranges[idx].bits = bits;
+        src_cpu->tlb_deferred_peer.count = idx + 1;
+    } else {
+        src_cpu->tlb_deferred_peer.full_idxmap |= idxmap;
+    }
+    return true;
+}
+
+bool tlb_flush_page_bits_by_mmuidx_all_cpus_deferred(CPUState *src_cpu,
+                                                     vaddr addr,
+                                                     MMUIdxMap idxmap,
+                                                     unsigned bits)
+{
+    return tlb_flush_range_by_mmuidx_all_cpus_deferred(src_cpu, addr,
+                                                       TARGET_PAGE_SIZE,
+                                                       idxmap, bits);
+}
+
+bool tlb_flush_page_by_mmuidx_all_cpus_deferred(CPUState *src_cpu,
+                                                vaddr addr,
+                                                MMUIdxMap idxmap)
+{
+    return tlb_flush_range_by_mmuidx_all_cpus_deferred(src_cpu, addr,
+                                                       TARGET_PAGE_SIZE,
+                                                       idxmap,
+                                                       target_long_bits());
+}
+
+bool tlb_flush_all_cpus_sync_pending(CPUState *src_cpu)
+{
+    uint16_t full_idxmap = src_cpu->tlb_deferred_peer.full_idxmap;
+    uint16_t count = src_cpu->tlb_deferred_peer.count;
+
+    if (!full_idxmap && !count) {
+        return false;
+    }
+    src_cpu->tlb_deferred_peer.full_idxmap = 0;
+    src_cpu->tlb_deferred_peer.count = 0;
+
+    int n_peers = 0;
+    CPUState *dst_cpu;
+    CPU_FOREACH(dst_cpu) {
+        if (dst_cpu != src_cpu) {
+            n_peers++;
+        }
+    }
+    if (n_peers == 0) {
+        return false;
+    }
+
+    TLBPeerBatch *batch = g_malloc(sizeof(*batch) +
+                                   count * sizeof(batch->ranges[0]));
+    batch->refcount = n_peers;
+    batch->full_idxmap = full_idxmap;
+    batch->count = count;
+    if (count) {
+        memcpy(batch->ranges, src_cpu->tlb_deferred_peer.ranges,
+               count * sizeof(batch->ranges[0]));
+    }
+
+    CPU_FOREACH(dst_cpu) {
+        if (dst_cpu != src_cpu) {
+            async_run_on_cpu_no_bql(dst_cpu, tlb_flush_peer_batch_async,
+                                    RUN_ON_CPU_HOST_PTR(batch));
+        }
+    }
+
+    if (full_idxmap && count == 0) {
+        cpu_sync_stat_inc(src_cpu,
+                          &src_cpu->sync_stats_counters.excl_tlbi_all);
+    } else if (!full_idxmap && count == 1 &&
+               batch->ranges[0].len <= TARGET_PAGE_SIZE &&
+               batch->ranges[0].bits >= target_long_bits()) {
+        cpu_sync_stat_inc(src_cpu,
+                          &src_cpu->sync_stats_counters.excl_tlbi_page);
+    } else {
+        cpu_sync_stat_inc(src_cpu,
+                          &src_cpu->sync_stats_counters.excl_tlbi_range);
+    }
+    async_safe_run_on_cpu_no_bql(src_cpu, tlb_flush_sync_noop_async,
+                                 RUN_ON_CPU_NULL);
+    return true;
+}
+
 /* update the TLBs so that writes to code in the virtual page 'addr'
    can be detected */
 void tlb_protect_code(ram_addr_t ram_addr)
