+void arm_pauth_op_selftest(void)
+{
+    g_autofree ARMCPU *cpu = g_new0(ARMCPU, 1);
+    CPUARMState *env = &cpu->env;
+    uint64_t seed = UINT64_C(0x3c6ef372fe94f82b);
+    static const uint8_t feats[3] = {
+        PauthFeat_1, PauthFeat_EPAC, PauthFeat_2
+    };
+
+    env->features = 1ULL << ARM_FEATURE_AARCH64;
+    cpu->prop_pauth_memo = true;
+    cpu->prop_pauth_memo_entries = 1024;
+    cpu->prop_pauth_memo_stats = false;
+    SET_IDREG(&cpu->isar, ID_AA64MMFR0, 0x0000000000100000ULL);
+
+    for (int fi = 0; fi < 3; fi++) {
+        SET_IDREG(&cpu->isar, ID_AA64ISAR1,
+                  FIELD_DP64(0, ID_AA64ISAR1, APA, feats[fi]));
+        memset(env->pauth_memo, 0, sizeof(env->pauth_memo));
+        memset(env->pauth_op_cache, 0, sizeof(env->pauth_op_cache));
+        memset(env->pauth_va_cache, 0, sizeof(env->pauth_va_cache));
+        arm_cpu_sync_fast_cfg(cpu);
+
+        for (int i = 0; i < 4096; i++) {
+            seed += UINT64_C(0x9e3779b97f4a7c15);
+            uint64_t r = (seed ^ (seed >> 30)) * UINT64_C(0xbf58476d1ce4e5b9);
+            r = (r ^ (r >> 27)) * UINT64_C(0x94d049bb133111eb);
+            r ^= r >> 31;
+
+            env->pstate = ((i & 1) ? PSTATE_MODE_EL1h : PSTATE_MODE_EL0t) |
+                          ((i & 2) ? PSTATE_PAN : 0);
+            env->cp15.sctlr_el[1] = (i % 17 == 0) ? 0
+                : (SCTLR_EnIA | SCTLR_EnIB | SCTLR_EnDA | SCTLR_EnDB);
+            unsigned tsz = 16 + (unsigned)(r & 15);
+            uint64_t tcr = ((uint64_t)tsz) | ((uint64_t)tsz << 16) |
+                           ((r & 0x100) ? (3ULL << 37) : 0) |
+                           ((r & 0x200) ? (3ULL << 51) : 0);
+            env->cp15.tcr_el[1] = tcr;
+            if ((i & 31) == 0) {
+                env->keys.apia = (ARMPACKey){ r, r ^ UINT64_C(0x1111222233334444) };
+                env->keys.apib = (ARMPACKey){ ~r, r + UINT64_C(0x5555666677778888) };
+                env->keys.apda = (ARMPACKey){ r ^ 0xaa55, ~r ^ 0x55aa };
+                env->keys.apdb = (ARMPACKey){ r * 3, r * 5 };
+            }
+
+            int bot = 64 - (int)tsz;
+            uint64_t canon_lo = r & MAKE_64BIT_MASK(0, bot);
+            uint64_t canon_hi = r | ~MAKE_64BIT_MASK(0, bot);
+            uint64_t ptr = (i % 3 == 0) ? canon_lo
+                           : (i % 3 == 1) ? canon_hi : r;
+            uint64_t mod = (r << 13) ^ (r >> 7);
+
+            /* Test PACIB -> hit PACIB -> pre-populated AUTIB/AUTIB_COMBINED -> forged */
+            uint64_t ref_sib = helper_pacib(env, ptr, mod);
+            uint64_t got_sib1 = helper_pauth_fast_pacib(env, ptr, mod);
+            uint64_t got_sib2 = helper_pauth_fast_pacib(env, ptr, mod);
+            g_assert_cmphex(got_sib1, ==, ref_sib);
+            g_assert_cmphex(got_sib2, ==, ref_sib);
+
+            uint64_t ref_aib = helper_autib(env, got_sib1, mod);
+            uint64_t ref_aibc = helper_autib_combined(env, got_sib1, mod);
+            g_assert_cmphex(helper_pauth_fast_autib(env, got_sib1, mod),
+                            ==, ref_aib);
+            g_assert_cmphex(helper_pauth_fast_autib_combined(env, got_sib1, mod),
+                            ==, ref_aibc);
+
+            uint64_t forged = got_sib1 ^ (1ULL << 50);
+            g_assert_cmphex(helper_pauth_fast_autib(env, forged, mod),
+                            ==, helper_autib(env, forged, mod));
+            g_assert_cmphex(helper_pauth_fast_autib_combined(env, forged, mod),
+                            ==, helper_autib_combined(env, forged, mod));
+
+            /* Test PACIA/AUTIA and PACDA/AUTDA */
+            uint64_t ref_sia = helper_pacia(env, ptr, mod);
+            g_assert_cmphex(helper_pauth_fast_pacia(env, ptr, mod), ==, ref_sia);
+            g_assert_cmphex(helper_pauth_fast_autia_combined(env, ref_sia, mod),
+                            ==, helper_autia_combined(env, ref_sia, mod));
+
+            uint64_t ref_sda = helper_pacda(env, ptr, mod);
+            g_assert_cmphex(helper_pauth_fast_pacda(env, ptr, mod), ==, ref_sda);
+            g_assert_cmphex(helper_pauth_fast_autda_combined(env, ref_sda, mod),
+                            ==, helper_autda_combined(env, ref_sda, mod));
+        }
+    }
+}
