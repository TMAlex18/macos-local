+
+enum {
+    PAUTH_OP_PACIA = 1,
+    PAUTH_OP_PACIB = 2,
+    PAUTH_OP_PACDA = 3,
+    PAUTH_OP_PACDB = 4,
+    PAUTH_OP_AUTIA = 5,
+    PAUTH_OP_AUTIB = 6,
+    PAUTH_OP_AUTDA = 7,
+    PAUTH_OP_AUTDB = 8,
+};
+
+static inline uint32_t pauth_op_cache_hash(uint64_t ptr, uint64_t mod,
+                                           unsigned op)
+{
+    uint64_t mixed = (ptr >> 2) ^ (ptr >> 14) ^ (ptr >> 26) ^ (ptr >> 38) ^
+                     (mod >> 4) ^ (mod >> 16) ^ (mod >> 28) ^
+                     ((uint64_t)op * UINT64_C(0x9e3779b9));
+    return (uint32_t)mixed & (ARM_PAUTH_OP_CACHE_SETS - 1);
+}
+
+static inline void pauth_op_cache_insert(CPUARMState *env, unsigned op,
+                                         unsigned el, uint64_t tcr,
+                                         ARMPACKey key, uint64_t in_ptr,
+                                         uint64_t mod, uint64_t out_ptr)
+{
+    uint32_t h = pauth_op_cache_hash(in_ptr, mod, op);
+    ARMPAuthOpCacheSet *set = &env->pauth_op_cache[h];
+    uint32_t tag = 0x80000000U | (op << 4) | (el & 3);
+
+    for (int i = 0; i < ARM_PAUTH_OP_CACHE_WAYS; i++) {
+        if (set->way[i].state_tag == tag && set->way[i].in_ptr == in_ptr &&
+            set->way[i].modifier == mod && set->way[i].tcr_el1 == tcr &&
+            set->way[i].key.lo == key.lo && set->way[i].key.hi == key.hi) {
+            set->way[i].out_ptr = out_ptr;
+            set->way[0].lru = (i == 0) ? 1 : 0;
+            return;
+        }
+    }
+
+    int victim = !(set->way[0].state_tag & 0x80000000U) ? 0
+                 : !(set->way[1].state_tag & 0x80000000U) ? 1
+                 : (set->way[0].lru & 1);
+    ARMPAuthOpCacheWay *w = &set->way[victim];
+    w->in_ptr = in_ptr;
+    w->modifier = mod;
+    w->out_ptr = out_ptr;
+    w->key = key;
+    w->tcr_el1 = tcr;
+    w->state_tag = tag;
+    set->way[0].lru = (victim == 0) ? 1 : 0;
+}
+
+static uint64_t pauth_fast_computepac_miss(CPUARMState *env, uint64_t data,
+                                           uint64_t modifier, ARMPACKey key)
+{
+    uint8_t alg = env->pauth_fast.algorithm;
+
+    if (unlikely(alg == 0)) {
+        return qemu_xxhash64_4(data, modifier, key.lo, key.hi);
+    }
+    if (likely(env->pauth_fast.memo_enabled)) {
+        uint32_t slot = (((uint32_t)(data >> 2) ^ (uint32_t)(data >> 32) ^
+                          (uint32_t)(modifier >> 4) ^
+                          (uint32_t)(modifier >> 36)) &
+                         env->pauth_fast.memo_mask);
+        ARMPAuthMemoEntry *entry = &env->pauth_memo[slot];
+        if (entry->valid && entry->data == data &&
+            entry->modifier == modifier && entry->key.lo == key.lo &&
+            entry->key.hi == key.hi && entry->algorithm == alg) {
+            if (env->pauth_fast.memo_stats) {
+                qatomic_set(&env->pauth_memo_hits,
+                            qatomic_read(&env->pauth_memo_hits) + 1);
+            }
+            return entry->result;
+        }
+        if (env->pauth_fast.memo_stats) {
+            qatomic_set(&env->pauth_memo_misses,
+                        qatomic_read(&env->pauth_memo_misses) + 1);
+        }
+        uint64_t res = arm_pauth_computepac_architected_fast(data, modifier,
+                                                             key, alg == 3);
+        *entry = (ARMPAuthMemoEntry) {
+            .data = data, .modifier = modifier, .key = key, .result = res,
+            .algorithm = alg, .valid = true,
+        };
+        return res;
+    }
+    return arm_pauth_computepac_architected_fast(data, modifier, key,
+                                                 alg == 3);
+}
+
+static G_NO_INLINE uint64_t
+pauth_op_miss_pac(CPUARMState *env, uint64_t ptr, uint64_t modifier,
+                  unsigned pac_op, unsigned aut_op, uint32_t en_bit,
+                  ARMPACKey key, bool data)
+{
+    if (unlikely(!env->pauth_fast.op_cache_enabled ||
+                 (env->pstate & PSTATE_nRW))) {
+        switch (pac_op) {
+        case PAUTH_OP_PACIA:
+            return helper_pacia(env, ptr, modifier);
+        case PAUTH_OP_PACIB:
+            return helper_pacib(env, ptr, modifier);
+        case PAUTH_OP_PACDA:
+            return helper_pacda(env, ptr, modifier);
+        default:
+            return helper_pacdb(env, ptr, modifier);
+        }
+    }
+
+    unsigned el = extract32(env->pstate, 2, 2);
+    uint64_t sctlr = env->cp15.sctlr_el[el == 0 ? 1 : el];
+    if (!(sctlr & en_bit)) {
+        return ptr;
+    }
+
+    ARMMMUIdx mmu_idx = (el == 0) ? ARMMMUIdx_Stage1_E0
+                        : ((env->pstate & PSTATE_PAN)
+                           ? ARMMMUIdx_Stage1_E1_PAN : ARMMMUIdx_Stage1_E1);
+    ARMVAParameters param = aa64_pauth_va_parameters(env, ptr, mmu_idx, data);
+    uint8_t pauth_feat = env->pauth_fast.pauth_feature;
+    uint64_t ext = param.tbi ? sextract64(ptr, 55, 1) : sextract64(ptr, 63, 1);
+    int top_bit = 64 - 8 * (param.tbi || param.mtx);
+    int bot_bit = 64 - param.tsz;
+    uint64_t ext_ptr = deposit64(ptr, bot_bit, top_bit - bot_bit, ext);
+
+    if (param.mtx && !param.tbi) {
+        ext_ptr = deposit64(ext_ptr, 60, 4, ext);
+    }
+
+    uint64_t pac = pauth_fast_computepac_miss(env, ext_ptr, modifier, key);
+    uint64_t test = sextract64(ptr, bot_bit, top_bit - bot_bit);
+
+    if (unlikely(test != 0 && test != UINT64_MAX)) {
+        if (pauth_feat >= PauthFeat_2) {
+            /* No action required */
+        } else if (pauth_feat == PauthFeat_EPAC) {
+            pac = 0;
+        } else {
+            pac ^= MAKE_64BIT_MASK(top_bit - 2, 1);
+        }
+    }
+
+    uint64_t orig_in = ptr;
+    if (pauth_feat >= PauthFeat_2) {
+        pac ^= ptr;
+    }
+    if (param.tbi) {
+        ptr &= ~MAKE_64BIT_MASK(bot_bit, 55 - bot_bit + 1);
+        pac &= MAKE_64BIT_MASK(bot_bit, 54 - bot_bit + 1);
+    } else if (param.mtx) {
+        ptr &= ~(MAKE_64BIT_MASK(60, 4) |
+                 MAKE_64BIT_MASK(bot_bit, 55 - bot_bit + 1));
+        pac &= MAKE_64BIT_MASK(60, 4) |
+               MAKE_64BIT_MASK(bot_bit, 54 - bot_bit + 1);
+    } else {
+        ptr &= MAKE_64BIT_MASK(0, bot_bit);
+        pac &= ~(MAKE_64BIT_MASK(55, 1) | MAKE_64BIT_MASK(0, bot_bit));
+    }
+    ext &= MAKE_64BIT_MASK(55, 1);
+    uint64_t out_ptr = pac | ext | ptr;
+    uint64_t tcr = env->cp15.tcr_el[1];
+
+    pauth_op_cache_insert(env, pac_op, el, tcr, key, orig_in, modifier, out_ptr);
+
+    /*
+     * Pre-populate verified inverse AUT mapping when input pointer has
+     * canonical extension bits across pauth_ptr_mask(param) and !mtx, so a
+     * cold function's matching RETAB/AUT* hits the leaf op cache immediately.
+     */
+    if (likely(!param.mtx &&
+               (((orig_in ^ (uint64_t)sextract64(orig_in, 55, 1)) &
+                 pauth_ptr_mask(param)) == 0))) {
+        pauth_op_cache_insert(env, aut_op, el, tcr, key, out_ptr, modifier,
+                              orig_in);
+    }
+    return out_ptr;
+}
+
+static G_NO_INLINE void
+pauth_check_trap_slow(CPUARMState *env, int el, uintptr_t ra)
+{
+    if (el < 2 && arm_is_el2_enabled(env)) {
+        uint64_t hcr = arm_hcr_el2_eff(env);
+        bool trap = !(hcr & HCR_API);
+        if (el == 0) {
+            trap &= (hcr & (HCR_E2H | HCR_TGE)) != (HCR_E2H | HCR_TGE);
+        }
+        if (trap) {
+            raise_exception_ra(env, EXCP_UDEF, syn_pactrap(), 2, ra);
+        }
+    }
+    if (el < 3 && arm_feature(env, ARM_FEATURE_EL3)) {
+        if (!(env->cp15.scr_el3 & SCR_API)) {
+            raise_exception_ra(env, EXCP_UDEF, syn_pactrap(), 3, ra);
+        }
+    }
+}
+
+static G_NO_INLINE uint64_t
+pauth_op_miss_aut(CPUARMState *env, uint64_t ptr, uint64_t modifier,
+                  unsigned aut_op, uint32_t en_bit, ARMPACKey key,
+                  bool data, int keynumber, bool is_combined, uintptr_t ra)
+{
+    bool fast_ok = env->pauth_fast.op_cache_enabled &&
+                   !(env->pstate & PSTATE_nRW);
+    int el = fast_ok ? (int)extract32(env->pstate, 2, 2) : arm_current_el(env);
+    uint64_t sctlr = fast_ok ? env->cp15.sctlr_el[el == 0 ? 1 : el]
+                             : arm_sctlr(env, el);
+
+    if (!(sctlr & en_bit)) {
+        return ptr;
+    }
+    if (unlikely(!fast_ok)) {
+        pauth_check_trap_slow(env, el, ra);
+    }
+
+    ARMMMUIdx mmu_idx = fast_ok
+                        ? ((el == 0) ? ARMMMUIdx_Stage1_E0
+                           : ((env->pstate & PSTATE_PAN)
+                              ? ARMMMUIdx_Stage1_E1_PAN : ARMMMUIdx_Stage1_E1))
+                        : arm_stage1_mmu_idx(env);
+    ARMVAParameters param = aa64_pauth_va_parameters(env, ptr, mmu_idx, data);
+    uint8_t pauth_feat = fast_ok ? env->pauth_fast.pauth_feature
+                                 : (uint8_t)cpu_isar_feature(pauth_feature,
+                                                             env_archcpu(env));
+    uint64_t mask = pauth_ptr_mask(param);
+    uint64_t orig_ptr = extract64(ptr, 55, 1) ? (ptr | mask) : (ptr & ~mask);
+    uint64_t pac = pauth_fast_computepac_miss(env, orig_ptr, modifier, key);
+    int bot_bit = 64 - param.tsz;
+    int top_bit = 64 - 8 * param.tbi;
+    uint64_t cmp_mask = MAKE_64BIT_MASK(bot_bit, top_bit - bot_bit) &
+                        ~MAKE_64BIT_MASK(55, 1);
+
+    if (param.mtx) {
+        cmp_mask &= ~MAKE_64BIT_MASK(56, 4);
+    }
+
+    if (pauth_feat >= PauthFeat_2) {
+        uint8_t fault_feat = is_combined ? PauthFeat_FPACCOMBINED
+                                         : PauthFeat_FPAC;
+        uint64_t result = ptr ^ (pac & cmp_mask);
+
+        if (unlikely(((result ^ (uint64_t)sextract64(result, 55, 1)) &
+                      cmp_mask) != 0)) {
+            if (pauth_feat >= fault_feat) {
+                raise_exception_ra(env, EXCP_UDEF,
+                                   syn_pacfail(data, keynumber),
+                                   exception_target_el(env), ra);
+            }
+            return result;
+        }
+        if (likely(fast_ok)) {
+            pauth_op_cache_insert(env, aut_op, (unsigned)el,
+                                  env->cp15.tcr_el[1], key, ptr, modifier,
+                                  result);
+        }
+        return result;
+    }
+
+    if (unlikely((pac ^ ptr) & cmp_mask)) {
+        int error_code = (keynumber << 1) | (keynumber ^ 1);
+        return param.tbi ? deposit64(orig_ptr, 53, 2, error_code)
+                         : deposit64(orig_ptr, 61, 2, error_code);
+    }
+    if (likely(fast_ok)) {
+        pauth_op_cache_insert(env, aut_op, (unsigned)el,
+                              env->cp15.tcr_el[1], key, ptr, modifier,
+                              orig_ptr);
+    }
+    return orig_ptr;
+}
+
+typedef struct PAuthOpHit {
+    uint64_t val;
+    bool hit;
+} PAuthOpHit;
+
+static inline QEMU_ALWAYS_INLINE PAuthOpHit
+pauth_op_try_hit(CPUARMState *env, uint64_t x, uint64_t y, unsigned op,
+                 uint32_t en_bit, ARMPACKey key)
+{
+    if (likely(env->pauth_fast.op_cache_enabled &&
+               !(env->pstate & PSTATE_nRW))) {
+        unsigned el = (unsigned)(env->pstate >> 2) & 3;
+        uint64_t sctlr = env->cp15.sctlr_el[el == 0 ? 1 : el];
+        if (unlikely(!(sctlr & en_bit))) {
+            return (PAuthOpHit){ .val = x, .hit = true };
+        }
+        uint64_t tcr = env->cp15.tcr_el[1];
+        uint32_t tag = 0x80000000U | (op << 4) | el;
+        uint32_t h = pauth_op_cache_hash(x, y, op);
+        ARMPAuthOpCacheSet *set = &env->pauth_op_cache[h];
+
+        for (int i = 0; i < ARM_PAUTH_OP_CACHE_WAYS; i++) {
+            const ARMPAuthOpCacheWay *w = &set->way[i];
+            if (w->state_tag == tag && w->in_ptr == x && w->modifier == y &&
+                w->tcr_el1 == tcr && w->key.lo == key.lo &&
+                w->key.hi == key.hi) {
+                set->way[0].lru = (i == 0) ? 1 : 0;
+                if (env->pauth_fast.memo_stats) {
+                    qatomic_set(&env->pauth_memo_hits,
+                                qatomic_read(&env->pauth_memo_hits) + 1);
+                }
+                return (PAuthOpHit){ .val = w->out_ptr, .hit = true };
+            }
+        }
+    }
+    return (PAuthOpHit){ .val = 0, .hit = false };
+}
+
+#define DEFINE_PAUTH_FAST_PAC(NAME, PAC_OP, AUT_OP, EN_BIT, KEY_FIELD, DATA) \
+uint64_t HELPER(NAME)(CPUARMState *env, uint64_t x, uint64_t y)              \
+{                                                                            \
+    ARMPACKey key = env->keys.KEY_FIELD;                                     \
+    PAuthOpHit r = pauth_op_try_hit(env, x, y, PAC_OP, EN_BIT, key);         \
+    if (likely(r.hit)) {                                                     \
+        return r.val;                                                        \
+    }                                                                        \
+    return pauth_op_miss_pac(env, x, y, PAC_OP, AUT_OP, EN_BIT, key, DATA);  \
+}
+
+#define DEFINE_PAUTH_FAST_AUT(NAME, AUT_OP, EN_BIT, KEY_FIELD, DATA, KEYNUM, COMB) \
+uint64_t HELPER(NAME)(CPUARMState *env, uint64_t x, uint64_t y)                    \
+{                                                                                  \
+    ARMPACKey key = env->keys.KEY_FIELD;                                           \
+    PAuthOpHit r = pauth_op_try_hit(env, x, y, AUT_OP, EN_BIT, key);               \
+    if (likely(r.hit)) {                                                           \
+        return r.val;                                                              \
+    }                                                                              \
+    return pauth_op_miss_aut(env, x, y, AUT_OP, EN_BIT, key, DATA, KEYNUM, COMB,   \
+                             GETPC());                                             \
+}
