+/*
+ * Optional host-only PCM boundary evidence. One exclusive file, at most 8 MiB.
+ * The format is documented/decoded by E05-usbip-kernel/pcm_boundary_trace.py.
+ * All integers are little endian. No captured bytes feed the audio path.
+ * Synchronous diagnostic I/O can affect timing; this is not a benchmark mode.
+ */
+#define PCM_TRACE_LIMIT (8 * 1024 * 1024)
+#define PCM_TRACE_WORDS 20
+#define PCM_TRACE_HEADER (PCM_TRACE_WORDS * sizeof(uint64_t))
+enum {
+    PCM_TRACE_POP = 1,
+    PCM_TRACE_POPULATE,
+    PCM_TRACE_WRITE,
+    PCM_TRACE_RETURN,
+    PCM_TRACE_CONTROL,
+    PCM_TRACE_END,
+};
+enum {
+    PCM_TRACE_DRAINED = 1,
+    PCM_TRACE_NOT_STARTED,
+    PCM_TRACE_FLUSH,
+};
+enum {
+    PCM_TRACE_COMPLETE = 1,
+    PCM_TRACE_CAPPED,
+    PCM_TRACE_ERROR,
+};
+
+static void virtio_snd_pcm_trace_end(VirtIOSound *s, uint64_t reason)
+{
+    uint64_t record[PCM_TRACE_WORDS] = { 0 };
+
+    if (!s->pcm_trace_file) {
+        return;
+    }
+    record[0] = cpu_to_le64(PCM_TRACE_END);
+    record[1] = cpu_to_le64(sizeof(record));
+    record[2] = cpu_to_le64(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+    record[3] = cpu_to_le64(s->pcm_trace_seq);
+    record[15] = cpu_to_le64(reason);
+    record[18] = cpu_to_le64(s->pcm_trace_bytes);
+    if (fwrite(record, sizeof(record), 1, s->pcm_trace_file) != 1) {
+        error_report("virtio-snd PCM trace: terminal record failed: %s",
+                     strerror(errno));
+    }
+    if (fclose(s->pcm_trace_file)) {
+        error_report("virtio-snd PCM trace: close failed: %s", strerror(errno));
+    }
+    s->pcm_trace_file = NULL;
+}
+
+static void virtio_snd_pcm_trace_exit(Notifier *notifier, void *data)
+{
+    VirtIOSound *s = container_of(notifier, VirtIOSound, pcm_trace_exit);
+
+    virtio_snd_pcm_trace_end(s, PCM_TRACE_COMPLETE);
+}
+
+static bool virtio_snd_pcm_trace_init(VirtIOSound *s, Error **errp)
+{
+    uint8_t header[16] = "VSNDPCM1";
+    int fd;
+
+    if (!s->pcm_trace_filename) {
+        return true;
+    }
+    fd = qemu_create(s->pcm_trace_filename, O_WRONLY | O_EXCL | O_BINARY,
+                     0600, errp);
+    if (fd < 0) {
+        return false;
+    }
+    s->pcm_trace_file = fdopen(fd, "wb");
+    if (!s->pcm_trace_file) {
+        error_setg_errno(errp, errno, "virtio-snd PCM trace fdopen");
+        close(fd);
+        return false;
+    }
+    setvbuf(s->pcm_trace_file, NULL, _IONBF, 0);
+    stq_le_p(header + 8, PCM_TRACE_LIMIT);
+    if (fwrite(header, sizeof(header), 1, s->pcm_trace_file) != 1) {
+        error_setg_errno(errp, errno, "virtio-snd PCM trace header");
+        fclose(s->pcm_trace_file);
+        s->pcm_trace_file = NULL;
+        return false;
+    }
+    s->pcm_trace_bytes = sizeof(header);
+    s->pcm_trace_exit.notify = virtio_snd_pcm_trace_exit;
+    qemu_add_exit_notifier(&s->pcm_trace_exit);
+    s->pcm_trace_exit_registered = true;
+    return true;
+}
+
+static void virtio_snd_pcm_trace(VirtIOSoundPCMStream *stream,
+                               VirtIOSoundPCMBuffer *buffer, uint64_t kind,
+                               uint64_t available, uint64_t requested,
+                               uint64_t accepted, uint64_t reason,
+                               const void *raw, size_t raw_len)
+{
+    VirtIOSound *s = stream->s;
+    uint64_t record[PCM_TRACE_WORDS] = { 0 };
+    g_autofree uint8_t *payload = NULL;
+    size_t sg_count, sg_bytes, total;
+
+    if (!s->pcm_trace_file) {
+        return;
+    }
+    sg_count = kind == PCM_TRACE_POP ? buffer->elem->out_num : 0;
+    sg_bytes = sg_count * 16;
+    /* Reserve the terminal record; refuse whole records, never partial PCM. */
+    if (raw_len > PCM_TRACE_LIMIT || sg_bytes > PCM_TRACE_LIMIT ||
+        raw_len + sg_bytes + PCM_TRACE_HEADER >
+        PCM_TRACE_LIMIT - PCM_TRACE_HEADER - s->pcm_trace_bytes) {
+        virtio_snd_pcm_trace_end(s, PCM_TRACE_CAPPED);
+        return;
+    }
+    total = PCM_TRACE_HEADER + sg_bytes + raw_len;
+    if (sg_bytes + raw_len) {
+        payload = g_try_malloc(sg_bytes + raw_len);
+        if (!payload) {
+            error_report("virtio-snd PCM trace: allocation failed; disabled");
+            virtio_snd_pcm_trace_end(s, PCM_TRACE_ERROR);
+            return;
+        }
+    }
+    if (kind == PCM_TRACE_POP) {
+        for (size_t i = 0; i < sg_count; i++) {
+            stq_le_p(payload + i * 16, buffer->elem->out_addr[i]);
+            stq_le_p(payload + i * 16 + 8, buffer->elem->out_sg[i].iov_len);
+        }
+        accepted = iov_to_buf(buffer->elem->out_sg, buffer->elem->out_num,
+                              sizeof(virtio_snd_pcm_xfer), payload + sg_bytes,
+                              raw_len);
+        if (accepted != raw_len) {
+            error_report("virtio-snd PCM trace: short pop snapshot; disabled");
+            virtio_snd_pcm_trace_end(s, PCM_TRACE_ERROR);
+            return;
+        }
+    } else if (raw_len) {
+        memcpy(payload, raw, raw_len);
+    }
+    record[0] = kind;
+    record[1] = total;
+    record[2] = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    record[3] = buffer ? buffer->pcm_trace_seq : 0;
+    record[4] = stream - s->streams;
+    record[5] = stream->pcm_trace_generation;
+    record[6] = stream->state;
+    record[7] = stream->params.channels;
+    record[8] = stream->params.format;
+    record[9] = stream->params.rate;
+    record[10] = buffer ? buffer->offset : 0;
+    record[11] = buffer ? buffer->size : 0;
+    record[12] = available;
+    record[13] = requested;
+    record[14] = accepted;
+    record[15] = reason;
+    record[16] = sg_count;
+    record[17] = raw_len;
+    for (size_t i = 0; i < ARRAY_SIZE(record); i++) {
+        cpu_to_le64s(&record[i]);
+    }
+    if (fwrite(record, sizeof(record), 1, s->pcm_trace_file) != 1 ||
+        (sg_bytes + raw_len &&
+         fwrite(payload, sg_bytes + raw_len, 1, s->pcm_trace_file) != 1)) {
+        error_report("virtio-snd PCM trace: write failed; disabled: %s",
+                     strerror(errno));
+        virtio_snd_pcm_trace_end(s, PCM_TRACE_ERROR);
+        return;
+    }
+    s->pcm_trace_bytes += total;
+}
