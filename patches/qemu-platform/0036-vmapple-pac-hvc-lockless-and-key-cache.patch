+static void vmapple_pac_update_user(VMApplePacCPU *p)
+{
+    if (p->user_valid &&
+        p->user_cached_a == p->a &&
+        p->user_cached_b == p->b &&
+        p->user_cached_diversifier == p->diversifier) {
+        return;
+    }
+
+    VMApplePacUserCacheEntry *slot =
+        &p->user_cache[vmapple_pac_cache_idx(p->diversifier)];
+    if (slot->valid &&
+        slot->a == p->a &&
+        slot->b == p->b &&
+        slot->diversifier == p->diversifier) {
+        memcpy(p->user, slot->user, sizeof(slot->user));
+    } else {
+        uint64_t seeds[4] = { p->a, p->a, p->b, p->b };
+        for (unsigned i = 0; i < 4; i++) {
+            p->user[i] = vmapple_pac_derive(p, i, seeds[i], true);
+            slot->user[i] = p->user[i];
