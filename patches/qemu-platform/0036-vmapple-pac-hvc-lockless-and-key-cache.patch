+/* Stack-only RFC 2104 HMAC-SHA256 for 32-byte key and 32-byte message. */
+static void vmapple_hmac_sha256_32(const uint8_t key[32],
+                                   const uint8_t msg[32],
+                                   uint8_t out[32])
+{
+    static const uint32_t iv[8] = {
+        0x6a09e667U, 0xbb67ae85U, 0x3c6ef372U, 0xa54ff53aU,
+        0x510e527fU, 0x9b05688cU, 0x1f83d9abU, 0x5be0cd19U,
+    };
+    uint8_t pad[64];
+    uint8_t tail[64];
+    uint32_t istate[8], ostate[8];
+
+    memcpy(istate, iv, sizeof(iv));
+    memcpy(ostate, iv, sizeof(iv));
+
+    for (unsigned i = 0; i < 32; i++) {
+        pad[i] = key[i] ^ 0x36U;
+    }
+    memset(pad + 32, 0x36, 32);
+    vmapple_sha256_compress(istate, pad);
+
+    memcpy(tail, msg, 32);
+    tail[32] = 0x80U;
+    memset(tail + 33, 0, 23);
+    stq_be_p(tail + 56, (64ULL + 32ULL) * 8ULL);
+    vmapple_sha256_compress(istate, tail);
+
+    for (unsigned i = 0; i < 32; i++) {
+        pad[i] = key[i] ^ 0x5cU;
+    }
+    memset(pad + 32, 0x5c, 32);
+    vmapple_sha256_compress(ostate, pad);
+
+    for (unsigned i = 0; i < 8; i++) {
+        stl_be_p(tail + i * 4, istate[i]);
+    }
+    tail[32] = 0x80U;
+    memset(tail + 33, 0, 23);
+    stq_be_p(tail + 56, (64ULL + 32ULL) * 8ULL);
+    vmapple_sha256_compress(ostate, tail);
+
+    for (unsigned i = 0; i < 8; i++) {
+        stl_be_p(out + i * 4, ostate[i]);
+    }
+}
