+uint32_t HELPER(try_board_hvc)(CPUARMState *env)
+{
+#ifdef CONFIG_USER_ONLY
+    return 0;
+#else
+    ARMCPU *cpu = env_archcpu(env);
+    CPUState *cs = env_cpu(env);
+
+    if (unlikely(cpu_single_stepping(cs) ||
+                 qemu_loglevel_mask(CPU_LOG_INT))) {
+        return 0;
+    }
+    if (is_a64(env) && arm_current_el(env) == 1 &&
+        cpu->psci_conduit == QEMU_PSCI_CONDUIT_HVC &&
+        cpu->board_hvc_lockless && cpu->board_hvc &&
+        cpu->board_hvc(cpu, cpu->board_hvc_opaque)) {
+        qemu_plugin_vcpu_hostcall_cb(cs, env->pc - 4);
+        return 1;
+    }
+    return 0;
+#endif
+}
