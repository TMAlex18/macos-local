From: macos-local research
Subject: [PATCH] Inline arm_stage1_mmu_idx, shrink-wrapped PAuth VA/memo fastpath, and 2-way L2 QARMA cache

Inline AArch64 EL1&0 arm_stage1_mmu_idx(), relocate hot PAuth/BTI metadata
before large ZA/memo arrays in CPUARMState for L1 DTLB locality, pad
ARMPAuthMemoEntry to 64B cache lines, return pre-packed ARMVAParameters on
VA-cache hits before the cold refill, and add a per-vCPU 2-way set-associative
L2 QARMA cache (active only when x-pauth-memo is enabled, cleared on reset and
migration post-load) plus pre-unpacked SSSE3 round constants.

diff --git a/target/arm/cpu.c b/target/arm/cpu.c
index 8b2c245..352799f 100644
--- a/target/arm/cpu.c
+++ b/target/arm/cpu.c
@@ -724,6 +724,7 @@ static void arm_cpu_reset_hold(Object *obj, ResetType type)
     if (cpu->board_hvc_reset) {
         cpu->board_hvc_reset(cpu, cpu->board_hvc_opaque);
     }
+    arm_cpu_sync_fast_cfg(cpu);
     if (tcg_enabled()) {
         hw_breakpoint_update_all(cpu);
         hw_watchpoint_update_all(cpu);
@@ -732,6 +733,31 @@ static void arm_cpu_reset_hold(Object *obj, ResetType type)
     }
 }
 
+void arm_cpu_sync_fast_cfg(ARMCPU *cpu)
+{
+    CPUARMState *env = &cpu->env;
+    uint8_t alg = 0;
+
+    QEMU_BUILD_BUG_ON(sizeof(ARMPAuthMemoEntry) != 64);
+    QEMU_BUILD_BUG_ON(sizeof(ARMPAuthQarmaL2Way) != 64);
+    QEMU_BUILD_BUG_ON(sizeof(ARMPAuthQarmaL2Set) != 128);
+
+    if (cpu_isar_feature(aa64_pauth_qarma5, cpu)) {
+        alg = 5;
+    } else if (cpu_isar_feature(aa64_pauth_qarma3, cpu)) {
+        alg = 3;
+    }
+    env->pauth_fast = (ARMPAuthFastCfg) {
+        .algorithm = alg,
+        .memo_enabled = cpu->prop_pauth_memo,
+        .memo_stats = cpu->prop_pauth_memo_stats,
+        .va_cache_enabled = true,
+        .has_aa64_bti = cpu_isar_feature(aa64_bti, cpu),
+        .memo_mask = cpu->prop_pauth_memo_entries
+                     ? (cpu->prop_pauth_memo_entries - 1) : 0,
+    };
+}
+
 void arm_emulate_firmware_reset(CPUState *cpustate, int target_el)
 {
     ARMCPU *cpu = ARM_CPU(cpustate);
@@ -2776,7 +2802,7 @@ static void arm_cpu_realizefn(DeviceState *dev, Error **errp)
 #ifdef CONFIG_TCG
         arm_pauth_qarma_selftest();
 #endif
-        env->pauth_va_cache_enabled = true;
+        arm_cpu_sync_fast_cfg(cpu);
     }
 
     qemu_init_vcpu(cs);
