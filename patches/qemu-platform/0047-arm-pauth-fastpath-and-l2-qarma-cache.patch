+static inline uint64_t qarma_l2_lookup_or_compute(ARMPAuthQarmaL2Set *sets,
+                                                  uint64_t data,
+                                                  uint64_t modifier,
+                                                  ARMPACKey key,
+                                                  bool isqarma3)
+{
+    uint64_t mixed = (data * UINT64_C(0x9e3779b97f4a7c15)) ^
+                     (modifier * UINT64_C(0xbf58476d1ce4e5b9)) ^
+                     (key.lo * UINT64_C(0x94d049bb133111eb));
+    uint32_t h = (uint32_t)(mixed >> (64 - ARM_PAUTH_QARMA_L2_BITS));
+    ARMPAuthQarmaL2Set *set = &sets[h];
+    uint8_t q3 = isqarma3 ? 1 : 0;
+
+    for (int i = 0; i < ARM_PAUTH_QARMA_L2_WAYS; i++) {
+        ARMPAuthQarmaL2Way *w = &set->way[i];
+        if (w->valid && w->data == data && w->modifier == modifier &&
+            w->key.lo == key.lo && w->key.hi == key.hi && w->isqarma3 == q3) {
+            set->way[0].lru = (i == 0) ? 1 : 0;
+            return w->result;
+        }
+    }
+
+    uint64_t res = arm_pauth_computepac_architected_fast(data, modifier,
+                                                         key, isqarma3);
+    int victim = !set->way[0].valid ? 0
+                 : !set->way[1].valid ? 1
+                 : (set->way[0].lru & 1);
+    ARMPAuthQarmaL2Way *w = &set->way[victim];
+    w->data = data;
+    w->modifier = modifier;
+    w->key = key;
+    w->result = res;
+    w->isqarma3 = q3;
+    w->valid = true;
+    set->way[0].lru = (victim == 0) ? 1 : 0;
+    return res;
+}
