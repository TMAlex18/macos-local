 void arm_pauth_qarma_selftest(void)
 {
     static gsize initialized;
@@ -1181,6 +1228,7 @@ void arm_pauth_qarma_selftest(void)
     if (g_once_init_enter(&initialized)) {
 #ifdef ARM_PAUTH_HAVE_X86_SIMD
         if (__builtin_cpu_supports("ssse3")) {
+            qarma_ssse3_init_consts();
             uint64_t seed = UINT64_C(0x6a09e667f3bcc908);
             for (int mode = 0; mode < 2; mode++) {
                 bool isq3 = (mode == 1);
@@ -1201,6 +1249,27 @@ void arm_pauth_qarma_selftest(void)
             arm_pauth_use_ssse3 = true;
         }
 #endif
+        g_autofree ARMPAuthQarmaL2Set *test_sets =
+            g_new0(ARMPAuthQarmaL2Set, ARM_PAUTH_QARMA_L2_SETS);
+        uint64_t l2_seed = UINT64_C(0xbb67ae8584caa73b);
+        ARMPACKey base_k = {
+            .lo = qarma_prng_next(&l2_seed),
+            .hi = qarma_prng_next(&l2_seed),
+        };
+        for (int i = 0; i < 512; i++) {
+            uint64_t d = UINT64_C(0x180001000) + ((uint64_t)i << 12);
+            uint64_t m = UINT64_C(0x16fd00000) + ((uint64_t)(i & 7) << 4);
+            bool isq3 = (i & 1) != 0;
+            uint64_t ref = qarma_scalar_compute(d, m, base_k, isq3);
+            g_assert_cmphex(qarma_l2_lookup_or_compute(test_sets, d, m,
+                                                       base_k, isq3), ==, ref);
+            g_assert_cmphex(qarma_l2_lookup_or_compute(test_sets, d, m,
+                                                       base_k, isq3), ==, ref);
+            uint64_t ref_alt = qarma_scalar_compute(d, m, base_k, !isq3);
+            g_assert_cmphex(qarma_l2_lookup_or_compute(test_sets, d, m,
+                                                       base_k, !isq3),
+                            ==, ref_alt);
+        }
         g_once_init_leave(&initialized, 1);
     }
 }
@@ -1215,3 +1284,11 @@ uint64_t arm_pauth_computepac_architected_fast(uint64_t data, uint64_t modifier,
 #endif
     return qarma_scalar_compute(data, modifier, key, isqarma3);
 }
