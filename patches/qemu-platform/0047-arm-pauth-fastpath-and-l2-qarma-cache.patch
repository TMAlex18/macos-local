+uint64_t arm_pauth_computepac_memo_miss(CPUARMState *env, uint64_t data,
+                                        uint64_t modifier, ARMPACKey key,
+                                        bool isqarma3)
+{
+    return qarma_l2_lookup_or_compute(env->pauth_qarma_l2, data, modifier,
+                                      key, isqarma3);
+}
