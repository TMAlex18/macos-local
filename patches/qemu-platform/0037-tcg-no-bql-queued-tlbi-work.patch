From: macos-local research
Subject: [PATCH] Run queued TLB flush work without the BQL

Add async_run_on_cpu_no_bql() and async_safe_run_on_cpu_no_bql(). When
tcg_cpu_exec() returns EXCP_INTERRUPT and the queued items at the head
are all marked no-BQL, the MTTCG thread runs them without the BQL and
goes straight back into the guest; the first other item sends it down
the normal BQL path, so queue order is kept. Cross-vCPU TLB flushes and
the RCU kick use the new calls: flush work only touches the target
vCPU's TLB, under that TLB's own lock.

diff --git a/accel/tcg/cputlb.c b/accel/tcg/cputlb.c
index e47a04e61a..5923a12e40 100644
--- a/accel/tcg/cputlb.c
+++ b/accel/tcg/cputlb.c
@@ -362,7 +362,7 @@ static void flush_all_helper(CPUState *src, run_on_cpu_func fn,
 
     CPU_FOREACH(cpu) {
         if (cpu != src) {
-            async_run_on_cpu(cpu, fn, d);
+            async_run_on_cpu_no_bql(cpu, fn, d);
         }
     }
 }
@@ -429,7 +429,7 @@ void tlb_flush_by_mmuidx_all_cpus_synced(CPUState *src_cpu, MMUIdxMap idxmap)
 
     flush_all_helper(src_cpu, fn, RUN_ON_CPU_HOST_INT(idxmap));
     cpu_sync_stat_inc(src_cpu, &src_cpu->sync_stats_counters.excl_tlbi_all);
-    async_safe_run_on_cpu(src_cpu, fn, RUN_ON_CPU_HOST_INT(idxmap));
+    async_safe_run_on_cpu_no_bql(src_cpu, fn, RUN_ON_CPU_HOST_INT(idxmap));
 }
 
 void tlb_flush_all_cpus_synced(CPUState *src_cpu)
@@ -633,8 +633,8 @@ void tlb_flush_page_by_mmuidx_all_cpus_synced(CPUState *src_cpu,
         flush_all_helper(src_cpu, tlb_flush_page_by_mmuidx_async_1,
                          RUN_ON_CPU_TARGET_PTR(addr | idxmap));
         cpu_sync_stat_inc(src_cpu, &src_cpu->sync_stats_counters.excl_tlbi_page);
-        async_safe_run_on_cpu(src_cpu, tlb_flush_page_by_mmuidx_async_1,
-                              RUN_ON_CPU_TARGET_PTR(addr | idxmap));
+        async_safe_run_on_cpu_no_bql(src_cpu, tlb_flush_page_by_mmuidx_async_1,
+                                     RUN_ON_CPU_TARGET_PTR(addr | idxmap));
     } else {
         CPUState *dst_cpu;
         TLBFlushPageByMMUIdxData *d;
@@ -645,8 +645,9 @@ void tlb_flush_page_by_mmuidx_all_cpus_synced(CPUState *src_cpu,
                 d = g_new(TLBFlushPageByMMUIdxData, 1);
                 d->addr = addr;
                 d->idxmap = idxmap;
-                async_run_on_cpu(dst_cpu, tlb_flush_page_by_mmuidx_async_2,
-                                 RUN_ON_CPU_HOST_PTR(d));
+                async_run_on_cpu_no_bql(dst_cpu,
+                                        tlb_flush_page_by_mmuidx_async_2,
+                                        RUN_ON_CPU_HOST_PTR(d));
             }
         }
 
@@ -654,8 +655,8 @@ void tlb_flush_page_by_mmuidx_all_cpus_synced(CPUState *src_cpu,
         d->addr = addr;
         d->idxmap = idxmap;
         cpu_sync_stat_inc(src_cpu, &src_cpu->sync_stats_counters.excl_tlbi_page);
-        async_safe_run_on_cpu(src_cpu, tlb_flush_page_by_mmuidx_async_2,
-                              RUN_ON_CPU_HOST_PTR(d));
+        async_safe_run_on_cpu_no_bql(src_cpu, tlb_flush_page_by_mmuidx_async_2,
+                                     RUN_ON_CPU_HOST_PTR(d));
     }
 }
 
@@ -837,15 +838,15 @@ void tlb_flush_range_by_mmuidx_all_cpus_synced(CPUState *src_cpu,
     CPU_FOREACH(dst_cpu) {
         if (dst_cpu != src_cpu) {
             p = g_memdup(&d, sizeof(d));
-            async_run_on_cpu(dst_cpu, tlb_flush_range_by_mmuidx_async_1,
-                             RUN_ON_CPU_HOST_PTR(p));
+            async_run_on_cpu_no_bql(dst_cpu, tlb_flush_range_by_mmuidx_async_1,
+                                    RUN_ON_CPU_HOST_PTR(p));
         }
     }
 
     p = g_memdup(&d, sizeof(d));
     cpu_sync_stat_inc(src_cpu, &src_cpu->sync_stats_counters.excl_tlbi_range);
-    async_safe_run_on_cpu(src_cpu, tlb_flush_range_by_mmuidx_async_1,
-                          RUN_ON_CPU_HOST_PTR(p));
+    async_safe_run_on_cpu_no_bql(src_cpu, tlb_flush_range_by_mmuidx_async_1,
+                                 RUN_ON_CPU_HOST_PTR(p));
 }
 
