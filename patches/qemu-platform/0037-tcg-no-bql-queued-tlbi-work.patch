diff --git a/accel/tcg/tcg-accel-ops-mttcg.c b/accel/tcg/tcg-accel-ops-mttcg.c
index af49aecec2..df8c953eae 100644
--- a/accel/tcg/tcg-accel-ops-mttcg.c
+++ b/accel/tcg/tcg-accel-ops-mttcg.c
@@ -27,6 +27,7 @@
 #include "exec/cpu-common.h"
 #include "system/tcg.h"
 #include "system/replay.h"
+#include "system/runstate.h"
 #include "exec/icount.h"
 #include "qemu/main-loop.h"
 #include "qemu/notify.h"
@@ -51,10 +52,10 @@ static void mttcg_force_rcu(Notifier *notify, void *data)
     CPUState *cpu = container_of(notify, MttcgForceRcuNotifier, notifier)->cpu;
 
     /*
-     * Called with rcu_registry_lock held, using async_run_on_cpu() ensures
-     * that there are no deadlocks.
+     * Called with rcu_registry_lock held, using async_run_on_cpu_no_bql()
+     * ensures that there are no deadlocks or unnecessary BQL acquisitions.
      */
-    async_run_on_cpu(cpu, do_nothing, RUN_ON_CPU_NULL);
+    async_run_on_cpu_no_bql(cpu, do_nothing, RUN_ON_CPU_NULL);
 }
 
 /*
@@ -93,7 +94,31 @@ static void *mttcg_cpu_thread_fn(void *arg)
             int excp;
 
             bql_unlock();
-            excp = tcg_cpu_exec(cpu);
+            for (;;) {
+                excp = tcg_cpu_exec(cpu);
+                if (excp != EXCP_INTERRUPT) {
+                    break;
+                }
+                qatomic_set(&cpu->exit_request, false);
+                qatomic_set_mb(&cpu->thread_kicked, false);
+                if (qatomic_read(&cpu->stop) ||
+                    qatomic_read(&cpu->unplug) ||
+                    qatomic_read(&cpu->halted) ||
+                    !runstate_is_running()) {
+                    break;
+                }
+                if (!process_queued_cpu_work_no_bql(cpu)) {
+                    break;
+                }
+                if (qatomic_read(&cpu->stop) ||
+                    qatomic_read(&cpu->unplug) ||
+                    qatomic_read(&cpu->halted) ||
+                    !runstate_is_running()) {
+                    break;
+                }
+                cpu_sync_stat_inc(cpu,
+                    &cpu->sync_stats_counters.no_bql_exit_interrupt);
+            }
             bql_lock();
             if (unlikely(cpu->sync_stats)) {
                 switch (excp) {
diff --git a/cpu-common.c b/cpu-common.c
index b6e195cc5c..5a7e5d0772 100644
--- a/cpu-common.c
+++ b/cpu-common.c
@@ -127,7 +127,7 @@ struct qemu_work_item {
     QSIMPLEQ_ENTRY(qemu_work_item) node;
     run_on_cpu_func func;
     run_on_cpu_data data;
-    bool free, exclusive, done;
+    bool free, exclusive, done, no_bql;
 };
 
 static void queue_work_on_cpu(CPUState *cpu, struct qemu_work_item *wi)
@@ -156,6 +156,7 @@ void do_run_on_cpu(CPUState *cpu, run_on_cpu_func func, run_on_cpu_data data,
     wi.done = false;
     wi.free = false;
     wi.exclusive = false;
+    wi.no_bql = false;
 
     queue_work_on_cpu(cpu, &wi);
     while (!qatomic_load_acquire(&wi.done)) {
@@ -178,6 +179,20 @@ void async_run_on_cpu(CPUState *cpu, run_on_cpu_func func, run_on_cpu_data data)
     queue_work_on_cpu(cpu, wi);
 }
 
+void async_run_on_cpu_no_bql(CPUState *cpu, run_on_cpu_func func,
+                             run_on_cpu_data data)
+{
+    struct qemu_work_item *wi;
+
+    wi = g_new0(struct qemu_work_item, 1);
+    wi->func = func;
+    wi->data = data;
+    wi->free = true;
+    wi->no_bql = true;
+
+    queue_work_on_cpu(cpu, wi);
+}
+
 /* Wait for pending exclusive operations to complete.  The CPU list lock
    must be held.  */
 static inline void exclusive_idle(void)
@@ -338,6 +353,21 @@ void async_safe_run_on_cpu(CPUState *cpu, run_on_cpu_func func,
     queue_work_on_cpu(cpu, wi);
 }
 
+void async_safe_run_on_cpu_no_bql(CPUState *cpu, run_on_cpu_func func,
+                                  run_on_cpu_data data)
+{
+    struct qemu_work_item *wi;
+
+    wi = g_new0(struct qemu_work_item, 1);
+    wi->func = func;
+    wi->data = data;
+    wi->free = true;
+    wi->exclusive = true;
+    wi->no_bql = true;
+
+    queue_work_on_cpu(cpu, wi);
+}
+
 void free_queued_cpu_work(CPUState *cpu)
 {
     while (!QSIMPLEQ_EMPTY(&cpu->work_list)) {
@@ -376,6 +406,7 @@ void process_queued_cpu_work(CPUState *cpu)
             end_exclusive();
             bql_lock();
             cpu_sync_stat_inc(cpu, &cpu->sync_stats_counters.queued_work_exclusive);
+            cpu_sync_stat_inc(cpu, &cpu->sync_stats_counters.bql_exclusive_reacquire);
         } else {
             cpu_sync_stat_inc(cpu, &cpu->sync_stats_counters.queued_work_ordinary);
             wi->func(cpu, wi->data);
@@ -391,6 +422,52 @@ void process_queued_cpu_work(CPUState *cpu)
     qemu_cond_broadcast(&qemu_work_cond);
 }
 
+bool process_queued_cpu_work_no_bql(CPUState *cpu)
+{
+    struct qemu_work_item *wi;
+    bool broadcast = false;
+    bool had_work = false;
+
+    qemu_mutex_lock(&cpu->work_mutex);
+    while (!QSIMPLEQ_EMPTY(&cpu->work_list)) {
+        wi = QSIMPLEQ_FIRST(&cpu->work_list);
+        if (!wi->no_bql) {
+            qemu_mutex_unlock(&cpu->work_mutex);
+            if (broadcast) {
+                qemu_cond_broadcast(&qemu_work_cond);
+            }
+            return false;
+        }
+        if (!had_work) {
+            had_work = true;
+            cpu_sync_stat_inc(cpu, &cpu->sync_stats_counters.queued_work_batches);
+        }
+        QSIMPLEQ_REMOVE_HEAD(&cpu->work_list, node);
+        qemu_mutex_unlock(&cpu->work_mutex);
+        if (wi->exclusive) {
+            start_exclusive();
+            wi->func(cpu, wi->data);
+            end_exclusive();
+            cpu_sync_stat_inc(cpu, &cpu->sync_stats_counters.queued_work_exclusive);
+        } else {
+            cpu_sync_stat_inc(cpu, &cpu->sync_stats_counters.queued_work_ordinary);
+            wi->func(cpu, wi->data);
+        }
+        qemu_mutex_lock(&cpu->work_mutex);
+        if (wi->free) {
+            g_free(wi);
+        } else {
+            qatomic_store_release(&wi->done, true);
+            broadcast = true;
+        }
+    }
+    qemu_mutex_unlock(&cpu->work_mutex);
+    if (broadcast) {
+        qemu_cond_broadcast(&qemu_work_cond);
+    }
+    return true;
+}
+
 /* Return true if PC matches an installed breakpoint.  */
 bool cpu_breakpoint_test(CPUState *cpu, vaddr pc, int mask)
 {
