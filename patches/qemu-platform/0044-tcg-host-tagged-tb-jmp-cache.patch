From: macos-local research
Subject: [PATCH] Host-RAM-tagged persistent CPUJumpCache across TLB invalidations

Record host_pc in CPUJumpCache for single-page RAM TBs and validate
hits in tb_lookup() against the active SoftMMU code TLB (or via
get_page_addr_code_hostp() on context-switch code-TLB refills, bypassing
global qht_lookup_custom). TLB invalidations no longer clear CPUJumpCache.

diff --git a/accel/tcg/cpu-exec.c b/accel/tcg/cpu-exec.c
--- a/accel/tcg/cpu-exec.c
+++ b/accel/tcg/cpu-exec.c
@@ -47,7 +47,9 @@
 #include "tb-internal.h"
 #include "internal-common.h"
 #if !defined(CONFIG_USER_ONLY)
+#include "accel/tcg/cpu-mmu-index.h"
 #include "accel/tcg/iommu.h"
+#include "exec/tlb-common.h"
 #endif
 
 /* -icount align implementation. */
@@ -195,6 +197,7 @@
     return false;
 }
 
+#ifdef CONFIG_USER_ONLY
 static TranslationBlock *tb_htable_lookup(CPUState *cpu, const TCGTBCPUState *s)
 {
     tb_page_addr_t phys_pc;
@@ -212,6 +215,36 @@
                      s->flags, s->cs_base, s->cflags);
     return qht_lookup_custom(&tb_ctx.htable, &desc, h, tb_lookup_cmp);
 }
+#else
+static inline bool tb_jmp_cache_code_host_match(CPUState *cpu, vaddr pc,
+                                                uintptr_t expected_host_pc)
+{
+    int mmu_idx = cpu_mmu_index(cpu, true);
+    CPUTLBDescFast *fast = cpu_tlb_fast(cpu, mmu_idx);
+    uintptr_t idx = (pc >> TARGET_PAGE_BITS) &
+                    (fast->mask >> CPU_TLB_ENTRY_BITS);
+    const CPUTLBEntry *entry = &fast->table[idx];
+    uintptr_t tlb_code = qatomic_read(&entry->addr_code);
+
+    return likely(tlb_code == (pc & TARGET_PAGE_MASK)) &&
+           likely(((uintptr_t)pc + entry->addend) == expected_host_pc);
+}
+
+static TranslationBlock *tb_htable_lookup_phys(CPUState *cpu,
+                                               const TCGTBCPUState *s,
+                                               tb_page_addr_t phys_pc)
+{
+    struct tb_desc desc;
+    uint32_t h;
+
+    desc.s = *s;
+    desc.env = cpu_env(cpu);
+    desc.page_addr0 = phys_pc;
+    h = tb_hash_func(phys_pc, (s->cflags & CF_PCREL ? 0 : s->pc),
+                     s->flags, s->cs_base, s->cflags);
+    return qht_lookup_custom(&tb_ctx.htable, &desc, h, tb_lookup_cmp);
+}
+#endif
 
 /**
  * tb_lookup:
@@ -236,6 +269,7 @@
     hash = tb_jmp_cache_hash_func(s->pc);
     jc = cpu->tb_jmp_cache;
 
+#ifdef CONFIG_USER_ONLY
     tb = qatomic_read(&jc->array[hash].tb);
     if (likely(tb &&
                jc->array[hash].pc == s->pc &&
@@ -252,6 +286,54 @@
 
     jc->array[hash].pc = s->pc;
     qatomic_set(&jc->array[hash].tb, tb);
+#else
+    void *host_pc = NULL;
+    tb_page_addr_t phys_pc;
+
+    tb = qatomic_read(&jc->array[hash].tb);
+    if (likely(tb &&
+               jc->array[hash].pc == s->pc &&
+               tb->cs_base == s->cs_base &&
+               tb->flags == s->flags &&
+               tb_cflags(tb) == s->cflags)) {
+        if (likely(jc->array[hash].host_pc != 0 &&
+                   tb_jmp_cache_code_host_match(cpu, s->pc,
+                                                jc->array[hash].host_pc))) {
+            goto hit;
+        }
+        phys_pc = get_page_addr_code_hostp(cpu_env(cpu), s->pc, &host_pc);
+        if (unlikely(phys_pc == -1)) {
+            return NULL;
+        }
+        tb = qatomic_read(&jc->array[hash].tb);
+        if (likely(tb &&
+                   jc->array[hash].pc == s->pc &&
+                   tb->cs_base == s->cs_base &&
+                   tb->flags == s->flags &&
+                   tb_cflags(tb) == s->cflags &&
+                   tb_page_addr1(tb) == -1 &&
+                   tb_page_addr0(tb) == phys_pc)) {
+            jc->array[hash].host_pc = (uintptr_t)host_pc;
+            goto hit;
+        }
+    } else {
+        phys_pc = get_page_addr_code_hostp(cpu_env(cpu), s->pc, &host_pc);
+        if (unlikely(phys_pc == -1)) {
+            return NULL;
+        }
+    }
+
+    tb = tb_htable_lookup_phys(cpu, s, phys_pc);
+    if (tb == NULL) {
+        return NULL;
+    }
+
+    if (likely(tb_page_addr1(tb) == -1 && host_pc != NULL)) {
+        jc->array[hash].pc = s->pc;
+        jc->array[hash].host_pc = (uintptr_t)host_pc;
+        qatomic_set(&jc->array[hash].tb, tb);
+    }
+#endif
 
 hit:
     /*
@@ -995,10 +1077,21 @@
                  * We add the TB in the virtual pc hash table
                  * for the fast lookup
                  */
+#ifdef CONFIG_USER_ONLY
                 h = tb_jmp_cache_hash_func(s.pc);
                 jc = cpu->tb_jmp_cache;
                 jc->array[h].pc = s.pc;
                 qatomic_set(&jc->array[h].tb, tb);
+#else
+                if (likely(tb_page_addr1(tb) == -1 &&
+                           tb_page_addr0(tb) != -1)) {
+                    h = tb_jmp_cache_hash_func(s.pc);
+                    jc = cpu->tb_jmp_cache;
+                    jc->array[h].pc = s.pc;
+                    jc->array[h].host_pc = 0;
+                    qatomic_set(&jc->array[h].tb, tb);
+                }
+#endif
             }
 
 #ifndef CONFIG_USER_ONLY
