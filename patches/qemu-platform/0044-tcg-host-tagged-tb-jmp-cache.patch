     if (to_clean == ALL_MMUIDX_BITS) {
         qatomic_set(&cpu->neg.tlb.c.full_flush_count,
@@ -549,7 +528,6 @@
                                              MMUIdxMap idxmap)
 {
     int mmu_idx;
-    bool had_16k = false;
 
     assert_cpu_is_self(cpu);
 
@@ -558,27 +536,10 @@
     qemu_spin_lock(&cpu->neg.tlb.c.lock);
     for (mmu_idx = 0; mmu_idx < NB_MMU_MODES; mmu_idx++) {
         if ((idxmap >> mmu_idx) & 1) {
-            if (cpu->neg.tlb.d[mmu_idx].has_16k_pages) {
-                had_16k = true;
-            }
             tlb_flush_page_locked(cpu, mmu_idx, addr);
         }
     }
     qemu_spin_unlock(&cpu->neg.tlb.c.lock);
-
-    /*
-     * Discard jump cache entries for any tb which might potentially
-     * overlap the flushed page, which includes the previous.
-     */
-    if (had_16k) {
-        vaddr base = addr & ~(vaddr)0x3fff;
-        for (vaddr ofs = 0; ofs <= 0x4000; ofs += TARGET_PAGE_SIZE) {
-            tb_jmp_cache_clear_page(cpu, base - TARGET_PAGE_SIZE + ofs);
-        }
-    } else {
-        tb_jmp_cache_clear_page(cpu, addr - TARGET_PAGE_SIZE);
-        tb_jmp_cache_clear_page(cpu, addr);
-    }
 }
 
 /**
@@ -759,7 +720,6 @@
                                               TLBFlushRangeData d)
 {
     int mmu_idx;
-    bool had_16k = false;
 
     assert_cpu_is_self(cpu);
 
@@ -769,38 +729,10 @@
     qemu_spin_lock(&cpu->neg.tlb.c.lock);
     for (mmu_idx = 0; mmu_idx < NB_MMU_MODES; mmu_idx++) {
         if ((d.idxmap >> mmu_idx) & 1) {
-            if (cpu->neg.tlb.d[mmu_idx].has_16k_pages) {
-                had_16k = true;
-            }
             tlb_flush_range_locked(cpu, mmu_idx, d.addr, d.len, d.bits);
         }
     }
     qemu_spin_unlock(&cpu->neg.tlb.c.lock);
-
-    if (had_16k) {
-        vaddr aligned = d.addr & ~(vaddr)0x3fff;
-        d.len = QEMU_ALIGN_UP((d.addr - aligned) + d.len, 0x4000);
