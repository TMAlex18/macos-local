+/* Each vCPU writes its own counters; QOM reads do not stop guest execution.
+ * CPU reset and migration post-load clear them while that CPU is quiescent.
+ * Separate property reads are not an atomic hit/miss snapshot.
+ */
+static void arm_get_pauth_memo_hits(Object *obj, Visitor *v, const char *name,
+                                   void *opaque, Error **errp)
+{
+    uint64_t value = qatomic_read(&ARM_CPU(obj)->env.pauth_memo_hits);
+
+    visit_type_uint64(v, name, &value, errp);
+}
+
+static void arm_get_pauth_memo_misses(Object *obj, Visitor *v, const char *name,
+                                     void *opaque, Error **errp)
+{
+    uint64_t value = qatomic_read(&ARM_CPU(obj)->env.pauth_memo_misses);
+
+    visit_type_uint64(v, name, &value, errp);
+}
+
 static void arm_cpu_initfn(Object *obj)
 {
     ARMCPU *cpu = ARM_CPU(obj);
+
+    object_property_add(obj, "x-pauth-memo-hits", "uint64",
+                        arm_get_pauth_memo_hits, NULL, NULL, NULL);
+    object_property_add(obj, "x-pauth-memo-misses", "uint64",
+                        arm_get_pauth_memo_misses, NULL, NULL, NULL);
 
     cpu->cp_regs = g_hash_table_new_full(g_direct_hash, g_direct_equal,
                                          NULL, g_free);
@@ -1854,6 +1883,18 @@
     CPUARMState *env = &cpu->env;
