+        error_setg(errp, "x-pauth-memo-entries must be 64 or 1024");
+        return;
+    }
+    if (!cpu->prop_pauth_memo &&
+        (cpu->prop_pauth_memo_entries != ARM_PAUTH_MEMO_DEFAULT_ENTRIES ||
+         cpu->prop_pauth_memo_stats)) {
+        error_setg(errp, "Memo capacity/statistics require x-pauth-memo=on");
+        return;
+    }
+
