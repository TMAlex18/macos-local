+            }
+            if (ldl_le_p(header) != 0xfeedfacf ||
+                ldl_le_p(header + 4) != 0x0100000c ||
+                ldl_le_p(identity) != 0x1b || ldl_le_p(identity + 4) != 24 ||
+                memcmp(identity + 8, d->uuid, sizeof(d->uuid)) ||
+                memcmp(context, d->sites[site].context, sizeof(context))) {
+                rejection = DIAG_IDENTITY_MISMATCH;
+                goto reject;
+            }
+        }
+        after = diag_context(env);
+        if (memcmp(&before, &after, sizeof(before))) {
+            rejection = DIAG_CONTEXT_CHANGED;
+            goto reject;
+        }
+        qatomic_set(&d->hits[site], qatomic_read(&d->hits[site]) + 1);
+        qatomic_set(&d->status, site ? DIAG_SITE1 : DIAG_SITE0);
+        return ARM_TIMEOUT_DIAG_VALUE;
+reject:
+        /* Other images at eligible FMOV PCs are expected candidates too.
+         * A rejection is not a guest exception or an application error.
+         */
+        qatomic_set(&d->rejections, qatomic_read(&d->rejections) + 1);
+        qatomic_set(&d->status, rejection);
