+    for (unsigned site = 0; site < ARM_TIMEOUT_DIAG_SITES; site++) {
+        uint8_t identity[24], header[8], context[ARM_TIMEOUT_DIAG_WINDOW];
+        ARMDiagContext before, after;
+        uint32_t rejection = DIAG_UNREADABLE;
+        uint64_t base;
+
+        if (insn != d->sites[site].instruction ||
+            (pc & 4095) != (d->sites[site].offset & 4095)) {
+            continue;
+        }
+        /* A shared image can have a different slide in each address space.
+         * CF_PCREL can also reuse this TB at another VA: use the actual PC,
+         * never the translating PC or another process's observed image base.
+         * This diagnostic is scoped to untagged, lower-48-bit user images.
+         * Reject arithmetic/range failures before any page-table read.
+         */
+        if (pc < d->sites[site].offset) {
+            rejection = DIAG_INVALID_CANDIDATE;
+            goto reject;
+        }
+        base = pc - d->sites[site].offset;
+        if (!base || (base & 4095) ||
+            base > (UINT64_C(1) << 48) - d->image_size) {
+            rejection = DIAG_INVALID_CANDIDATE;
+            goto reject;
+        }
+        before = diag_context(env);
+        for (unsigned pass = 0; pass < 2; pass++) {
