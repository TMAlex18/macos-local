+/* KDF domains are local model choices, never claimed Apple-compatible bytes. */
+static ARMPACKey vmapple_pac_derive(const VMApplePacCPU *p, unsigned role,
+                                  uint64_t seed, bool el0)
+{
+    uint8_t data[32] = { 'M', 'L', 'P', 'A', 'C', 1, 0, 0 };
+    uint8_t digest[32];
+    gsize length = sizeof(digest);
+    GHmac *h = g_hmac_new(G_CHECKSUM_SHA256, p->master, 32);
+    data[6] = role;
+    data[7] = el0;
+    stq_le_p(data + 8, seed);
+    stq_le_p(data + 16, el0 ? p->diversifier : 0);
+    g_hmac_update(h, data, sizeof(data));
+    g_hmac_get_digest(h, digest, &length);
+    g_hmac_unref(h);
+    return (ARMPACKey){ .lo = ldq_le_p(digest), .hi = ldq_le_p(digest + 8) };
+}
+
+static void vmapple_pac_apply(ARMCPU *cpu, void *opaque)
+{
+    VMApplePacCPU *p = opaque;
+    ARMPACKey *k;
+    if (!p->initialized) {
+        return;
+    }
+    k = (arm_current_el(&cpu->env) == 0 || p->force_el0) ? p->user : p->kernel;
+    cpu->env.keys.apia = k[0];
+    cpu->env.keys.apda = k[1];
+    cpu->env.keys.apib = k[2];
+    cpu->env.keys.apdb = k[3];
+    cpu->env.keys.apga = k[4];
+}
+
+static void vmapple_pac_rekey(ARMCPU *cpu, VMApplePacCPU *p)
+{
+    uint64_t seeds[] = { p->a, p->a, p->b, p->b, p->g };
+    for (unsigned i = 0; i < 5; i++) {
+        p->kernel[i] = vmapple_pac_derive(p, i, seeds[i], false);
+        p->user[i] = i == 4 ? p->kernel[i] :
+                    vmapple_pac_derive(p, i, seeds[i], true);
+    }
+    vmapple_pac_apply(cpu, p);
+}
+
+static void vmapple_pac_cpu_reset(ARMCPU *cpu, void *opaque)
+{
+    VMApplePacCPU *p = opaque;
+    p->initialized = false;
+    p->force_el0 = false;
+    p->a = p->b = p->diversifier = p->g = 0;
+    memset(p->kernel, 0, sizeof(p->kernel));
+    memset(p->user, 0, sizeof(p->user));
+}
+
+static bool vmapple_pac_hvc(ARMCPU *cpu, void *opaque)
+{
+    VMApplePacCPU *p = opaque;
+    uint64_t *x = cpu->env.xregs;
+    uint64_t fid = x[0];
+    unsigned fn;
+    if ((fid & ~0xffULL) != 0xc1000000ULL) {
+        return false;
+    }
+    fn = fid & 0xff;
+    /* Unknown functions must not mutate state or report false success. */
+    if (fn > 6 && fn != 0xf0) {
+        x[0] = -1;                  /* SMCCC NOT_SUPPORTED */
+        return true;
+    }
+    if (fn == 0xf0) {
+        x[0] = 0;                   /* documented NOP */
+        return true;
+    }
+    if (fn != 0 && !p->initialized) {
+        x[0] = -3;                  /* explicit model pre-init refusal */
+        return true;
+    }
+    if (fn == 5 && x[1] > 1) {
+        x[0] = -2;                  /* invalid boolean; no mutation */
+        return true;
+    }
+    switch (fn) {
+    case 0:
+        p->a = p->defaults[0];
+        p->b = p->defaults[1];
+        p->diversifier = p->defaults[2];
+        p->g = p->defaults[3];
+        p->force_el0 = false;
+        p->initialized = true;
+        break;
+    case 1:
+        for (unsigned i = 0; i < 4; i++) {
+            x[i + 1] = p->defaults[i];
+        }
+        x[0] = 0;
+        return true;
+    case 2: p->a = x[1]; break;
+    case 3: p->b = x[1]; break;
+    case 4: p->diversifier = x[1]; break;
+    case 5:
+        p->force_el0 = x[1];
+        p->diversifier = x[2];
+        break;
+    case 6: p->g = x[1]; break;
+    default: g_assert_not_reached();
+    }
+    vmapple_pac_rekey(cpu, p);
+    x[0] = 0;
+    return true;
+}
