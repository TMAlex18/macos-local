+/* Experimental software state model; NOT Apple's hardware PAC cipher or
+ * proprietary key derivation. Guest architectural authentication stays active.
+ * A per-VM random master and domain-separated HMAC-SHA256 derive 128-bit keys.
+ * This is deliberately opt-in and has no migration compatibility promise. */
+typedef struct VMApplePacCPU {
+    const uint8_t *master;
+    const uint64_t *defaults;
+    uint64_t a, b, diversifier, g;
+    bool initialized, force_el0;
+    ARMPACKey kernel[5], user[5];
+} VMApplePacCPU;
 
