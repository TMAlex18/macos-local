+/* Caller holds RCU; memory_region_find does not invoke IOMMU translation. */
+static bool arm_diag_phys_read(CPUARMState *env, ARMSecuritySpace space,
+                              hwaddr address, void *dest, size_t size)
+{
+    MemTxAttrs attrs = { .space = space, .secure = arm_space_is_secure(space) };
+    AddressSpace *as = arm_addressspace(env_cpu(env), attrs);
+    MemoryRegionSection section = memory_region_find(as->root, address, size);
+    bool ok = false;
+
+    if (section.mr && section.offset_within_address_space == address &&
+        int128_eq(section.size, int128_make64(size)) &&
+        memory_region_is_ram(section.mr) &&
+        !memory_region_is_ram_device(section.mr) &&
+        !memory_region_is_protected(section.mr)) {
+        void *host = memory_region_get_ram_ptr(section.mr) +
+                     section.offset_within_region;
+
+        /* Keep naturally aligned page-table descriptor reads atomic. */
+        if (size == 8 && QEMU_IS_ALIGNED((uintptr_t)host, 8)) {
+            uint64_t value = qatomic_read((uint64_t *)host);
+            memcpy(dest, &value, size);
+        } else if (size == 4 && QEMU_IS_ALIGNED((uintptr_t)host, 4)) {
+            uint32_t value = qatomic_read((uint32_t *)host);
+            memcpy(dest, &value, size);
+        } else {
+            memcpy(dest, host, size);
+        }
+        ok = true;
+    }
+    if (section.mr) {
+        memory_region_unref(section.mr);
+    }
+    return ok;
+}
