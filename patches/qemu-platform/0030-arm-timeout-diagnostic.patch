diff --git a/target/arm/timeout-diagnostic.c b/target/arm/timeout-diagnostic.c
new file mode 100644
--- /dev/null
+++ b/target/arm/timeout-diagnostic.c
@@ -0,0 +1,337 @@
+/* Default-off, local two-site 3.0 -> 30.0 timeout diagnostic.
+ * No image bytes or addresses are built in; the operator supplies a private
+ * identity contract. Guest code and storage are never written here.
+ */
+#include "qemu/osdep.h"
+#include "cpu.h"
+#include "internals.h"
+#include "timeout-diagnostic.h"
+#include "qemu/atomic.h"
+#include "qemu/units.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qobject/qdict.h"
+#include "qobject/qlist.h"
+#include "qobject/qnum.h"
+#include "qobject/qstring.h"
+#include "qobject/qjson.h"
+#include "migration/blocker.h"
+#include "system/runstate.h"
+#include "system/tcg.h"
+
+typedef struct ARMTimeoutSite {
+    uint64_t offset;
+    uint64_t context_offset;
+    uint32_t instruction;
+    uint8_t context[ARM_TIMEOUT_DIAG_WINDOW];
+} ARMTimeoutSite;
+
+struct ARMTimeoutDiagnostic {
+    uint64_t image_size;
+    uint64_t uuid_offset;
+    uint8_t uuid[16];
+    ARMTimeoutSite sites[ARM_TIMEOUT_DIAG_SITES];
+    /* Published only with all vCPUs stopped; reset/post-load revoke it. */
+    uint64_t base;
+    uint64_t epoch;
+    uint64_t hits[ARM_TIMEOUT_DIAG_SITES];
+    uint64_t failures;
+    uint32_t status;
+    Error *migration_blocker;
+};
+
+enum {
+    DIAG_UNARMED, DIAG_ARMED, DIAG_SITE0, DIAG_SITE1,
+    DIAG_UNREADABLE, DIAG_IDENTITY_MISMATCH, DIAG_CONTEXT_CHANGED,
+};
+
+static bool diag_uint(QDict *dict, const char *name, uint64_t *value)
+{
+    QNum *num = dict ? qobject_to(QNum, qdict_get(dict, name)) : NULL;
+    return num && qnum_get_try_uint(num, value);
+}
+
+static bool diag_hex(QDict *dict, const char *name, uint8_t *bytes, size_t size)
+{
+    const char *text = dict ? qdict_get_try_str(dict, name) : NULL;
+    if (!text || strlen(text) != size * 2) {
+        return false;
+    }
+    for (size_t i = 0; i < size; i++) {
+        int a = g_ascii_xdigit_value(text[2 * i]);
+        int b = g_ascii_xdigit_value(text[2 * i + 1]);
+        if (a < 0 || b < 0) {
+            return false;
+        }
+        bytes[i] = (a << 4) | b;
+    }
+    return true;
+}
+
+static bool diag_fmov_d_three(uint32_t insn)
+{
+    /* Decode the public A64 FMOV (scalar immediate) fields, preserving Rd. */
+    return extract32(insn, 24, 8) == 0x1e &&
+           extract32(insn, 22, 2) == 1 && extract32(insn, 21, 1) == 1 &&
+           extract32(insn, 13, 8) == 8 && extract32(insn, 5, 8) == 0x80;
+}
+
+bool arm_timeout_diag_realize(ARMCPU *cpu, Error **errp)
+{
+    g_autofree char *contents = NULL;
+    QObject *object = NULL;
+    g_autofree ARMTimeoutDiagnostic *diag = NULL;
+    GError *file_error = NULL;
+    size_t length;
+    uint64_t number;
+    QDict *root, *image, *macho;
+    QList *sites;
+    const QListEntry *entry;
+    unsigned i = 0;
+
+    if (!cpu->prop_webkit_timeout_diagnostic) {
+        return true;
+    }
+    if (!tcg_enabled() || !arm_feature(&cpu->env, ARM_FEATURE_AARCH64)) {
+        error_setg(errp, "Timeout diagnostic requires AArch64 system TCG");
+        return false;
+    }
+    if (!g_file_get_contents(cpu->prop_webkit_timeout_diagnostic, &contents,
+                             &length, &file_error)) {
+        g_clear_error(&file_error);
+        error_setg(errp, "Cannot read private timeout diagnostic contract");
+        return false;
+    }
+    if (length > 65536 || strlen(contents) != length) {
+        goto invalid;
+    }
+    object = qobject_from_json(contents, NULL);
+    root = qobject_to(QDict, object);
+    image = root ? qobject_to(QDict, qdict_get(root, "image")) : NULL;
+    macho = image ? qobject_to(QDict, qdict_get(image, "mach_o")) : NULL;
+    sites = root ? qobject_to(QList, qdict_get(root, "sites")) : NULL;
+    diag = g_new0(ARMTimeoutDiagnostic, 1);
+    if (!diag_uint(root, "schema_version", &number) || number != 1 ||
+        !image || !macho || !sites || qlist_size(sites) != ARM_TIMEOUT_DIAG_SITES ||
+        !diag_uint(image, "text_segment_size", &diag->image_size) ||
+        diag->image_size < 64 || diag->image_size > 256 * MiB ||
+        !diag_uint(macho, "lc_uuid_payload_image_offset", &diag->uuid_offset) ||
+        diag->uuid_offset < 8 || diag->uuid_offset > diag->image_size - 16 ||
+        !diag_hex(image, "uuid_bytes_hex", diag->uuid, sizeof(diag->uuid))) {
+        goto invalid;
+    }
+    QLIST_FOREACH_ENTRY(sites, entry) {
+        QDict *site = qobject_to(QDict, qlist_entry_obj(entry));
+        QDict *context = site ? qobject_to(QDict, qdict_get(site, "context")) : NULL;
+        ARMTimeoutSite *s = &diag->sites[i++];
+        uint64_t context_size, instruction;
+
+        if (!diag_uint(site, "image_offset", &s->offset) ||
+            s->offset > diag->image_size - 4 || (s->offset & 3) ||
+            !diag_uint(site, "original_instruction_u32", &instruction) ||
+            instruction > UINT32_MAX || !diag_fmov_d_three(instruction) ||
+            !diag_uint(context, "image_offset", &s->context_offset) ||
+            !diag_uint(context, "length", &context_size) ||
+            context_size != sizeof(s->context) ||
+            s->context_offset > diag->image_size - sizeof(s->context) ||
+            s->offset < s->context_offset ||
+            s->offset - s->context_offset > sizeof(s->context) - 4 ||
+            !diag_hex(context, "original_bytes_hex", s->context, sizeof(s->context))) {
+            goto invalid;
+        }
+        s->instruction = instruction;
+        if (ldl_le_p(s->context + s->offset - s->context_offset) != instruction) {
+            goto invalid;
+        }
+    }
+    if (diag->sites[0].offset == diag->sites[1].offset) {
+        goto invalid;
+    }
+    error_setg(&diag->migration_blocker,
+               "Migration disabled while the timeout diagnostic profile is enabled");
+    if (migrate_add_blocker(&diag->migration_blocker, errp)) {
+        qobject_unref(object);
+        return false;
+    }
+    cpu->webkit_timeout_diagnostic = g_steal_pointer(&diag);
+    qobject_unref(object);
+    return true;
+invalid:
+    qobject_unref(object);
+    error_setg(errp, "Invalid private two-site timeout diagnostic contract");
+    return false;
+}
+
+void arm_timeout_diag_destroy(ARMCPU *cpu)
+{
+    ARMTimeoutDiagnostic *diag = cpu->webkit_timeout_diagnostic;
+    if (diag) {
+        migrate_del_blocker(&diag->migration_blocker);
+        g_free(diag);
+        cpu->webkit_timeout_diagnostic = NULL;
+    }
+}
+
+void arm_timeout_diag_reset(ARMCPU *cpu)
+{
+    ARMTimeoutDiagnostic *d = cpu->webkit_timeout_diagnostic;
+    if (d) {
+        qatomic_set(&d->base, 0);
+        qatomic_set(&d->status, DIAG_UNARMED);
+        qatomic_set(&d->epoch, qatomic_read(&d->epoch) + 1);
+        qatomic_set(&d->failures, 0);
+        for (unsigned i = 0; i < ARM_TIMEOUT_DIAG_SITES; i++) {
+            qatomic_set(&d->hits[i], 0);
+        }
+    }
+}
+
+static void diag_set_base(Object *obj, Visitor *v, const char *name,
+                          void *opaque, Error **errp)
+{
+    ARMTimeoutDiagnostic *d = ARM_CPU(obj)->webkit_timeout_diagnostic;
+    uint64_t base;
+
+    if (!visit_type_uint64(v, name, &base, errp)) {
+        return;
+    }
+    if (!d || runstate_is_running() ||
+        !(runstate_check(RUN_STATE_PAUSED) || runstate_check(RUN_STATE_PRELAUNCH)) ||
+        (base && ((base & 4095) || base > UINT64_MAX - d->image_size))) {
+        error_setg(errp, "Timeout diagnostic base requires enabled profile and paused VM");
+        return;
+    }
+    qatomic_set(&d->base, base);
+    qatomic_set(&d->status, base ? DIAG_ARMED : DIAG_UNARMED);
+    qatomic_set(&d->epoch, qatomic_read(&d->epoch) + 1);
+}
+
+static void diag_get_armed(Object *obj, Visitor *v, const char *name,
+                           void *opaque, Error **errp)
+{
+    ARMTimeoutDiagnostic *d = ARM_CPU(obj)->webkit_timeout_diagnostic;
+    bool armed = d && qatomic_read(&d->base);
+    visit_type_bool(v, name, &armed, errp);
+}
+
+static void diag_get_count(Object *obj, Visitor *v, const char *name,
+                           void *opaque, Error **errp)
+{
+    ARMTimeoutDiagnostic *d = ARM_CPU(obj)->webkit_timeout_diagnostic;
+    uintptr_t which = (uintptr_t)opaque;
+    uint64_t value = 0;
+    if (d) {
+        value = which < 2 ? qatomic_read(&d->hits[which]) :
+                which == 2 ? qatomic_read(&d->failures) : qatomic_read(&d->epoch);
+    }
+    visit_type_uint64(v, name, &value, errp);
+}
+
+static char *diag_get_status(Object *obj, Error **errp)
+{
+    ARMTimeoutDiagnostic *d = ARM_CPU(obj)->webkit_timeout_diagnostic;
+    static const char *const names[] = {
+        "unarmed", "armed-unverified", "site0-verified", "site1-verified",
+        "unreadable-or-unsupported", "identity-mismatch", "context-changed",
+    };
+    return g_strdup(d ? names[qatomic_read(&d->status)] : "off");
+}
+
+void arm_timeout_diag_properties(Object *obj)
+{
+    object_property_add(obj, "x-webkit-timeout-base", "uint64", NULL,
+                         diag_set_base, NULL, NULL);
+    object_property_add(obj, "x-webkit-timeout-armed", "bool", diag_get_armed,
+                         NULL, NULL, NULL);
+    object_property_add_str(obj, "x-webkit-timeout-status", diag_get_status, NULL);
+    object_property_add(obj, "x-webkit-timeout-site0-hits", "uint64",
+                         diag_get_count, NULL, NULL, (void *)0);
+    object_property_add(obj, "x-webkit-timeout-site1-hits", "uint64",
+                         diag_get_count, NULL, NULL, (void *)1);
+    object_property_add(obj, "x-webkit-timeout-failures", "uint64",
+                         diag_get_count, NULL, NULL, (void *)2);
+    object_property_add(obj, "x-webkit-timeout-epoch", "uint64",
+                         diag_get_count, NULL, NULL, (void *)3);
+}
+
+bool arm_timeout_diag_translate(ARMCPU *cpu, uint64_t pc, uint32_t insn)
+{
+    ARMTimeoutDiagnostic *d = cpu->webkit_timeout_diagnostic;
+    for (unsigned i = 0; i < ARM_TIMEOUT_DIAG_SITES; i++) {
+        if (insn == d->sites[i].instruction &&
+            (pc & 4095) == (d->sites[i].offset & 4095)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+typedef struct ARMDiagContext {
+    uint64_t ttbr0, ttbr1, tcr, tcr2, sctlr, sctlr2, hcr, scr, gpccr;
+    uint64_t mair, mair2;
+    uint64_t mmu_idx;
+} ARMDiagContext;
+
+static ARMDiagContext diag_context(CPUARMState *env)
+{
+    return (ARMDiagContext) {
+        .ttbr0 = env->cp15.ttbr0_el[1], .ttbr1 = env->cp15.ttbr1_el[1],
+        .tcr = env->cp15.tcr_el[1], .tcr2 = env->cp15.tcr2_el[1],
+        .sctlr = env->cp15.sctlr_el[1], .sctlr2 = env->cp15.sctlr2_el[1],
+        .hcr = arm_hcr_el2_eff(env), .scr = env->cp15.scr_el3,
+        .gpccr = env->cp15.gpccr_el3, .mair = env->cp15.mair_el[1],
+        .mair2 = env->cp15.mair2_el[1], .mmu_idx = arm_mmu_idx(env),
+    };
+}
+
+uint64_t arm_timeout_diag_value(CPUARMState *env, uint64_t pc, uint32_t insn)
+{
+    ARMTimeoutDiagnostic *d = env_archcpu(env)->webkit_timeout_diagnostic;
+    uint8_t identity[24], header[8], context[ARM_TIMEOUT_DIAG_WINDOW];
+    ARMDiagContext before, after;
+    unsigned site;
+    uint32_t failure = DIAG_UNREADABLE;
+    uint64_t base;
+
+    if (!d || !(base = qatomic_read(&d->base))) {
+        return ARM_TIMEOUT_DIAG_ORIGINAL;
+    }
+    for (site = 0; site < ARM_TIMEOUT_DIAG_SITES; site++) {
+        if (pc == base + d->sites[site].offset &&
+            insn == d->sites[site].instruction) {
+            break;
+        }
+    }
+    if (site == ARM_TIMEOUT_DIAG_SITES) {
+        return ARM_TIMEOUT_DIAG_ORIGINAL;
+    }
+    before = diag_context(env);
+    for (unsigned pass = 0; pass < 2; pass++) {
+        if (!arm_cpu_read_diag_ram(env, base, header, sizeof(header)) ||
+            !arm_cpu_read_diag_ram(env, base + d->uuid_offset - 8,
+                                   identity, sizeof(identity)) ||
+            !arm_cpu_read_diag_ram(env, base + d->sites[site].context_offset,
+                                   context, sizeof(context))) {
+            goto fail;
+        }
+        if (ldl_le_p(header) != 0xfeedfacf || ldl_le_p(header + 4) != 0x0100000c ||
+            ldl_le_p(identity) != 0x1b || ldl_le_p(identity + 4) != 24 ||
+            memcmp(identity + 8, d->uuid, sizeof(d->uuid)) ||
+            memcmp(context, d->sites[site].context, sizeof(context))) {
+            failure = DIAG_IDENTITY_MISMATCH;
+            goto fail;
+        }
+    }
+    after = diag_context(env);
+    if (memcmp(&before, &after, sizeof(before))) {
+        failure = DIAG_CONTEXT_CHANGED;
+        goto fail;
+    }
+    qatomic_set(&d->hits[site], qatomic_read(&d->hits[site]) + 1);
+    qatomic_set(&d->status, site ? DIAG_SITE1 : DIAG_SITE0);
+    return ARM_TIMEOUT_DIAG_VALUE;
+fail:
+    qatomic_set(&d->failures, qatomic_read(&d->failures) + 1);
+    qatomic_set(&d->status, failure);
+    return ARM_TIMEOUT_DIAG_ORIGINAL;
+}
diff --git a/target/arm/timeout-diagnostic.h b/target/arm/timeout-diagnostic.h
new file mode 100644
--- /dev/null
+++ b/target/arm/timeout-diagnostic.h
@@ -0,0 +1,18 @@
+/* Local, default-off two-site FP-immediate timeout diagnostic. */
+#ifndef TARGET_ARM_TIMEOUT_DIAGNOSTIC_H
+#define TARGET_ARM_TIMEOUT_DIAGNOSTIC_H
+
+#define ARM_TIMEOUT_DIAG_SITES 2
+#define ARM_TIMEOUT_DIAG_WINDOW 64
+#define ARM_TIMEOUT_DIAG_ORIGINAL UINT64_C(0x4008000000000000)
+#define ARM_TIMEOUT_DIAG_VALUE UINT64_C(0x403e000000000000)
+
+#ifndef CONFIG_USER_ONLY
+void arm_timeout_diag_properties(Object *obj);
+bool arm_timeout_diag_realize(ARMCPU *cpu, Error **errp);
+void arm_timeout_diag_destroy(ARMCPU *cpu);
+void arm_timeout_diag_reset(ARMCPU *cpu);
+bool arm_timeout_diag_translate(ARMCPU *cpu, uint64_t pc, uint32_t insn);
+uint64_t arm_timeout_diag_value(CPUARMState *env, uint64_t pc, uint32_t insn);
+#endif
+#endif
