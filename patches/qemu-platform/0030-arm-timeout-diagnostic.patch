+bool arm_cpu_read_diag_ram(CPUARMState *env, vaddr addr,
+                           void *buffer, size_t length)
+{
+    ARMMMUIdx mmu_idx = arm_mmu_idx(env);
+    uint8_t *dest = buffer;
+
+    /* Deliberately small EL0/NS stage-1 scope. Reject before any PTW read. */
+    if (!env->aarch64 || arm_current_el(env) != 0 ||
+        mmu_idx != ARMMMUIdx_E10_0 ||
+        arm_security_space_below_el3(env) != ARMSS_NonSecure ||
+        !(env->cp15.sctlr_el[1] & SCTLR_M) ||
+        (arm_hcr_el2_eff(env) & (HCR_VM | HCR_DC)) ||
+        FIELD_EX64(env->cp15.gpccr_el3, GPCCR, GPC) ||
+        length == 0 || length > 64 || addr > UINT64_MAX - length) {
+        return false;
+    }
+
+    RCU_READ_LOCK_GUARD();
+    while (length) {
+        S1Translate ptw = {
+            .in_mmu_idx = mmu_idx,
+            .in_space = ARMSS_NonSecure,
+            .in_debug = true,
+            .in_debug_ram_only = true,
+            .in_at = true,
+            .in_prot_check = 0,
+        };
+        GetPhysAddrResult result = {};
+        ARMMMUFaultInfo fault = {};
+        size_t size = MIN(length, TARGET_PAGE_SIZE - (addr & ~TARGET_PAGE_MASK));
+
+        if (!get_phys_addr_nogpc(env, &ptw, addr, MMU_DATA_LOAD, MO_8,
+                                &result, &fault) ||
+            result.f.attrs.space != ARMSS_NonSecure ||
+            !arm_diag_phys_read(env, ARMSS_NonSecure, result.f.phys_addr,
+                                dest, size)) {
+            return false;
+        }
+        addr += size;
+        dest += size;
+        length -= size;
+    }
+    return true;
+}
