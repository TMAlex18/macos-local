-    o |= extract64(i, 60, 4) << 60;
-
-    return o;
+    /* Group cells with the same displacement modulo 64. */
+    return (i & UINT64_C(0xf000000f00000000)) |
+           (rol64(i, 12) & UINT64_C(0x000000000000f00f)) |
+           (rol64(i, 16) & UINT64_C(0x00f0000000000000)) |
+           (rol64(i, 20) & UINT64_C(0x000000000f000000)) |
+           (rol64(i, 24) & UINT64_C(0x0000f0f000000000)) |
+           (rol64(i, 28) & UINT64_C(0x0000000000000f00)) |
+           (rol64(i, 36) & UINT64_C(0x0000000000f00000)) |
+           (rol64(i, 40) & UINT64_C(0x0f0f000000000000)) |
+           (rol64(i, 44) & UINT64_C(0x00000000000000f0)) |
+           (rol64(i, 48) & UINT64_C(0x00000f0000000000)) |
