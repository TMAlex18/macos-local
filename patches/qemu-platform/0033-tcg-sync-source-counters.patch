@@ -1266,6 +1283,180 @@ static void arm_get_pauth_memo_misses(Object *obj, Visitor *v, const char *name,
     visit_type_uint64(v, name, &value, errp);
 }
 
+static void append_json_escaped_str(GString *out, const char *s)
+{
+    g_string_append_c(out, '"');
+    for (const unsigned char *p = (const unsigned char *)(s ? s : "?"); *p; p++) {
+        if (*p == '"' || *p == '\\') {
+            g_string_append_c(out, '\\');
+            g_string_append_c(out, (char)*p);
+        } else if (*p < 0x20) {
+            g_string_append_printf(out, "\\u%04x", *p);
+        } else {
+            g_string_append_c(out, (char)*p);
+        }
+    }
+    g_string_append_c(out, '"');
+}
+
+static int cmp_cstr_ptr(const void *a, const void *b)
+{
+    const char *sa = *(const char * const *)a;
+    const char *sb = *(const char * const *)b;
+    return strcmp(sa, sb);
+}
+
+static void append_rw_pair_map(GString *out, GHashTable *map)
+{
+    guint len = 0;
+    gpointer *keys = g_hash_table_get_keys_as_array(map, &len);
+
+    if (len > 1) {
+        qsort(keys, len, sizeof(gpointer), cmp_cstr_ptr);
+    }
+    g_string_append_c(out, '{');
+    for (guint i = 0; i < len; i++) {
+        const char *k = keys[i];
+        const uint64_t *rw = g_hash_table_lookup(map, k);
+        if (i > 0) {
+            g_string_append_c(out, ',');
+        }
+        append_json_escaped_str(out, k);
+        g_string_append_printf(out, ":[%" PRIu64 ",%" PRIu64 "]", rw[0], rw[1]);
+    }
+    g_string_append_c(out, '}');
+    g_free(keys);
+}
+
+static bool is_tlbi_reg_name(const char *name)
+{
+    return name && (g_str_has_prefix(name, "TLBI") ||
+                    g_str_has_prefix(name, "ITLBI") ||
+                    g_str_has_prefix(name, "DTLBI"));
+}
+
+static char *arm_get_sync_stats_json(Object *obj, Error **errp)
+{
+    ARMCPU *cpu = ARM_CPU(obj);
+    CPUState *cs = CPU(cpu);
+    GString *out = g_string_new(NULL);
+
+    if (!cs->sync_stats) {
+        g_string_append(out, "{\"enabled\":false}");
+        return g_string_free(out, FALSE);
+    }
+
+    GHashTable *seen_ptrs = g_hash_table_new(g_direct_hash, g_direct_equal);
+    GHashTable *io_map = g_hash_table_new_full(g_str_hash, g_str_equal, g_free, g_free);
+    GHashTable *tlbi_map = g_hash_table_new_full(g_str_hash, g_str_equal, g_free, g_free);
+    GHashTable *other_map = g_hash_table_new_full(g_str_hash, g_str_equal, g_free, g_free);
+
+    if (cpu->cp_regs) {
+        GHashTableIter iter;
+        gpointer key, value;
+        g_hash_table_iter_init(&iter, cpu->cp_regs);
+        while (g_hash_table_iter_next(&iter, &key, &value)) {
+            const ARMCPRegInfo *ri = value;
+            if (!ri || g_hash_table_contains(seen_ptrs, ri)) {
+                continue;
+            }
+            g_hash_table_add(seen_ptrs, (gpointer)ri);
+            uint64_t r = qatomic_read(&ri->sync_reads);
+            uint64_t w = qatomic_read(&ri->sync_writes);
+            if (r == 0 && w == 0) {
+                continue;
+            }
+            const char *rname = ri->name ? ri->name : "unnamed";
+            GHashTable *dest = (ri->type & ARM_CP_IO) ? io_map
+                               : (is_tlbi_reg_name(rname) ? tlbi_map : other_map);
+            uint64_t *slot = g_hash_table_lookup(dest, rname);
+            if (!slot) {
+                slot = g_new0(uint64_t, 2);
+                g_hash_table_insert(dest, g_strdup(rname), slot);
+            }
+            slot[0] += r;
+            slot[1] += w;
+        }
+    }
+
+    #define RD_CNT(field) qatomic_read(&cs->sync_stats_counters.field)
+    g_string_append_printf(
+        out,
+        "{\"enabled\":true"
+        ",\"exit_interrupt\":%" PRIu64
+        ",\"exit_hlt\":%" PRIu64
+        ",\"exit_halted\":%" PRIu64
+        ",\"exit_yield\":%" PRIu64
+        ",\"exit_atomic\":%" PRIu64
+        ",\"exit_debug\":%" PRIu64
+        ",\"exit_other\":%" PRIu64
+        ",\"bql_atomic_reacquire\":%" PRIu64
+        ",\"halt_cond_waits\":%" PRIu64
+        ",\"queued_work_batches\":%" PRIu64
+        ",\"queued_work_ordinary\":%" PRIu64
+        ",\"queued_work_exclusive\":%" PRIu64
+        ",\"bql_do_interrupt\":%" PRIu64
+        ",\"do_interrupt_svc\":%" PRIu64
+        ",\"do_interrupt_abort\":%" PRIu64
+        ",\"do_interrupt_irq\":%" PRIu64
+        ",\"do_interrupt_other\":%" PRIu64
+        ",\"bql_handle_interrupt\":%" PRIu64
+        ",\"bql_eret\":%" PRIu64
+        ",\"bql_cpreg_read\":%" PRIu64
+        ",\"bql_cpreg_write\":%" PRIu64
+        ",\"bql_mmio\":%" PRIu64
+        ",\"bql_ptw\":%" PRIu64
+        ",\"excl_tlbi_all\":%" PRIu64
+        ",\"excl_tlbi_page\":%" PRIu64
+        ",\"excl_tlbi_range\":%" PRIu64
+        ",\"excl_step_atomic\":%" PRIu64
+        ",\"excl_tb_flush\":%" PRIu64,
+        RD_CNT(exit_interrupt),
+        RD_CNT(exit_hlt),
+        RD_CNT(exit_halted),
+        RD_CNT(exit_yield),
+        RD_CNT(exit_atomic),
+        RD_CNT(exit_debug),
+        RD_CNT(exit_other),
+        RD_CNT(bql_atomic_reacquire),
+        RD_CNT(halt_cond_waits),
+        RD_CNT(queued_work_batches),
+        RD_CNT(queued_work_ordinary),
+        RD_CNT(queued_work_exclusive),
+        RD_CNT(bql_do_interrupt),
+        RD_CNT(do_interrupt_svc),
+        RD_CNT(do_interrupt_abort),
+        RD_CNT(do_interrupt_irq),
+        RD_CNT(do_interrupt_other),
+        RD_CNT(bql_handle_interrupt),
+        RD_CNT(bql_eret),
+        RD_CNT(bql_cpreg_read),
+        RD_CNT(bql_cpreg_write),
+        RD_CNT(bql_mmio),
+        RD_CNT(bql_ptw),
+        RD_CNT(excl_tlbi_all),
+        RD_CNT(excl_tlbi_page),
+        RD_CNT(excl_tlbi_range),
+        RD_CNT(excl_step_atomic),
+        RD_CNT(excl_tb_flush)
+    );
+    #undef RD_CNT
+
+    g_string_append(out, ",\"cpreg_io\":");
+    append_rw_pair_map(out, io_map);
+    g_string_append(out, ",\"tlbi\":");
+    append_rw_pair_map(out, tlbi_map);
+    g_string_append(out, ",\"cpreg_non_io_helper\":");
+    append_rw_pair_map(out, other_map);
+    g_string_append_c(out, '}');
+
+    g_hash_table_destroy(other_map);
+    g_hash_table_destroy(tlbi_map);
+    g_hash_table_destroy(io_map);
+    g_hash_table_destroy(seen_ptrs);
+    return g_string_free(out, FALSE);
+}
+
 static void arm_cpu_initfn(Object *obj)
