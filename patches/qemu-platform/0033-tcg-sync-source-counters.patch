@@ -590,6 +624,23 @@ struct CPUState {
     CPUNegativeOffsetState neg;
 };
 
+static inline void cpu_sync_stat_inc(CPUState *cpu, uint64_t *counter)
+{
+    if (unlikely(cpu && cpu->sync_stats)) {
+        qatomic_set(counter, *counter + 1);
+    }
+}
+
+static inline void cpu_sync_stats_reset(CPUState *cpu)
+{
+    uint64_t *p = (uint64_t *)&cpu->sync_stats_counters;
+    size_t n = sizeof(cpu->sync_stats_counters) / sizeof(uint64_t);
+
+    for (size_t i = 0; i < n; i++) {
+        qatomic_set(&p[i], 0);
+    }
+}
+
 /* Validate placement of CPUNegativeOffsetState. */
 QEMU_BUILD_BUG_ON(offsetof(CPUState, neg) !=
                   sizeof(CPUState) - sizeof(CPUNegativeOffsetState));
