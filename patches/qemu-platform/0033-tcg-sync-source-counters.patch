From: macos-local research
Subject: [PATCH] Add default-off per-vCPU TCG BQL and exclusive-section source counters

Expose opt-in x-sync-stats=on and read-only x-sync-stats-json on ARM CPUs to
count, per vCPU without extra locks, each MTTCG outer-loop exit reason,
cpu_exec BQL acquisition site, ERET hook BQL acquisition, ARM_CP_IO register
read/write by register name, TLBI helper invocation by instruction name, and
start_exclusive/async_safe_run_on_cpu source. Default-off; guest semantics and
migrated state are unchanged.

diff --git a/accel/tcg/cpu-exec.c b/accel/tcg/cpu-exec.c
index 767eae2..b3add9b 100644
--- a/accel/tcg/cpu-exec.c
+++ b/accel/tcg/cpu-exec.c
@@ -553,6 +553,7 @@ void cpu_exec_step_atomic(CPUState *cpu)
 
     if (sigsetjmp(cpu->jmp_env, 0) == 0) {
         start_exclusive();
+        cpu_sync_stat_inc(cpu, &cpu->sync_stats_counters.excl_step_atomic);
         g_assert(cpu == current_cpu);
         g_assert(!cpu->running);
         cpu->running = true;
@@ -725,6 +726,7 @@ static inline bool cpu_handle_exception(CPUState *cpu, int *excp)
         const TCGCPUOps *tcg_ops = cpu->cc->tcg_ops;
 
         bql_lock();
+        cpu_sync_stat_inc(cpu, &cpu->sync_stats_counters.bql_do_interrupt);
         tcg_ops->do_interrupt(cpu);
         bql_unlock();
         cpu->exception_index = -1;
@@ -799,6 +801,7 @@ static inline bool cpu_handle_interrupt(CPUState *cpu,
 #else
     if (unlikely(cpu_test_interrupt(cpu, ~0))) {
         bql_lock();
+        cpu_sync_stat_inc(cpu, &cpu->sync_stats_counters.bql_handle_interrupt);
         if (cpu_test_interrupt(cpu, CPU_INTERRUPT_DEBUG)) {
             cpu_reset_interrupt(cpu, CPU_INTERRUPT_DEBUG);
             cpu->exception_index = EXCP_DEBUG;
