+static void cpreg_sync_reset_one(gpointer key, gpointer value, gpointer opaque)
+{
+    ARMCPRegInfo *ri = value;
+
+    qatomic_set(&ri->sync_reads, 0);
+    qatomic_set(&ri->sync_writes, 0);
+}
+
+void arm_cpu_sync_stats_reset(ARMCPU *cpu)
+{
+    cpu_sync_stats_reset(CPU(cpu));
+    if (cpu->cp_regs) {
+        g_hash_table_foreach(cpu->cp_regs, cpreg_sync_reset_one, NULL);
+    }
+}
