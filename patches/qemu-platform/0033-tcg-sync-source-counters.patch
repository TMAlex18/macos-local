diff --git a/accel/tcg/tcg-accel-ops-mttcg.c b/accel/tcg/tcg-accel-ops-mttcg.c
index e7edd19..af49aec 100644
--- a/accel/tcg/tcg-accel-ops-mttcg.c
+++ b/accel/tcg/tcg-accel-ops-mttcg.c
@@ -95,6 +95,31 @@ static void *mttcg_cpu_thread_fn(void *arg)
             bql_unlock();
             excp = tcg_cpu_exec(cpu);
             bql_lock();
+            if (unlikely(cpu->sync_stats)) {
+                switch (excp) {
+                case EXCP_INTERRUPT:
+                    cpu_sync_stat_inc(cpu, &cpu->sync_stats_counters.exit_interrupt);
+                    break;
+                case EXCP_HLT:
+                    cpu_sync_stat_inc(cpu, &cpu->sync_stats_counters.exit_hlt);
+                    break;
+                case EXCP_HALTED:
+                    cpu_sync_stat_inc(cpu, &cpu->sync_stats_counters.exit_halted);
+                    break;
+                case EXCP_YIELD:
+                    cpu_sync_stat_inc(cpu, &cpu->sync_stats_counters.exit_yield);
+                    break;
+                case EXCP_ATOMIC:
+                    cpu_sync_stat_inc(cpu, &cpu->sync_stats_counters.exit_atomic);
+                    break;
+                case EXCP_DEBUG:
+                    cpu_sync_stat_inc(cpu, &cpu->sync_stats_counters.exit_debug);
+                    break;
+                default:
+                    cpu_sync_stat_inc(cpu, &cpu->sync_stats_counters.exit_other);
+                    break;
+                }
+            }
             switch (excp) {
             case EXCP_DEBUG:
                 cpu_handle_guest_debug(cpu);
@@ -109,6 +134,7 @@ static void *mttcg_cpu_thread_fn(void *arg)
                 bql_unlock();
                 cpu_exec_step_atomic(cpu);
                 bql_lock();
+                cpu_sync_stat_inc(cpu, &cpu->sync_stats_counters.bql_atomic_reacquire);
             default:
                 /* Ignore everything else? */
                 break;
