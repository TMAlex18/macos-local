     fn allocate_anywhere(&self, len: u64) -> Result<HostAddr, KernReturn>;
+    /// Fresh zero-filled backing whose pages can be shared by `remap_shared_overwrite`.
+    /// Mach allocations already have this property. Platforms that distinguish address
+    /// reservations from shareable storage must provide the latter here. Released with
+    /// `deallocate`, like `allocate_anywhere`.
+    fn allocate_aliasable(&self, len: u64) -> Result<HostAddr, KernReturn> {
+        self.allocate_anywhere(len)
