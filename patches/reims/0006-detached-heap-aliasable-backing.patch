+    /// A temporary heap backing is shareable before its first detach. Its 20 MiB can also
+    /// be viewed in swapped 16 KiB guest-page order on a 4 KiB host; writes work both ways,
+    /// a view of the fragmented view keeps the pages after both older mappings go, and an
+    /// out-of-range remap changes neither the target's pages nor its backing-table entries.
+    #[test]
+    fn aliasable_heap_pages_survive_segmented_views_and_refused_ranges() {
+        let v = vm();
+        let length = 0x140_0000;
+        let guest_page = 0x4000;
+        assert_eq!(v.page_size(), 0x1000);
+        let source = HostVm::allocate_aliasable(&v, length).unwrap();
+        let view = v.allocate_anywhere(length).unwrap();
+        let retained = v.allocate_anywhere(length).unwrap();
+        for i in 0..length / guest_page {
+            let offset = i * guest_page;
+            assert_eq!(read(source, offset), 0);
+            write(source, offset, 0x31);
+            v.remap_shared_overwrite(
+                view.wrapping_add(offset),
+                source.wrapping_add((i ^ 1) * guest_page),
+                guest_page,
+            )
+            .unwrap();
+        }
+        v.remap_shared_overwrite(retained, view, length).unwrap();
+        for i in 0..length / guest_page {
+            let offset = i * guest_page;
+            assert_eq!(read(retained, offset), 0x31);
+            write(retained, offset + guest_page - 1, 0x72);
+            assert_eq!(read(source, (i ^ 1) * guest_page + guest_page - 1), 0x72);
+            write(source, (i ^ 1) * guest_page + 1, 0x53);
+            assert_eq!(read(view, offset + 1), 0x53);
+        }
+        assert_eq!(
+            v.remap_shared_overwrite(retained, source, u64::MAX),
+            Err(INVALID_ARGUMENT)
+        );
+        // Make a known hole inside the source, rather than assume a neighbour is unmapped.
+        assert!(
+            v.deallocate(source.wrapping_add(guest_page), guest_page)
+                .is_success()
+        );
+        assert_eq!(
+            v.remap_shared_overwrite(retained, source, length),
+            Err(INVALID_ADDRESS)
+        );
+        assert_eq!(read(retained, 0), 0x31);
+        assert_eq!(read(retained, 1), 0x53);
+        assert_eq!(read(retained, guest_page - 1), 0x72);
+        assert!(files::pieces(retained.addr().to_u64(), length).is_some());
+        assert!(v.deallocate(source, length).is_success());
+        assert!(v.deallocate(view, length).is_success());
+        for i in 0..length / guest_page {
+            let offset = i * guest_page;
+            assert_eq!(read(retained, offset + guest_page - 1), 0x72);
+            write(retained, offset, 0xa4);
+            assert_eq!(read(retained, offset), 0xa4);
+        }
+        assert!(v.deallocate(retained, length).is_success());
+        for at in [source, view, retained] {
+            assert!(files::pieces(at.addr().to_u64(), length).is_none());
+            assert!(!mapped(at));
+        }
+        assert_eq!(HostVm::allocate_aliasable(&v, 0), Ok(HostAddr::NULL));
+    }
+
     /// The host's page, which the tests lay their pages out by: x86-64's 4 KiB.
     pub(crate) const PAGE: u64 = 0x1000;
 
