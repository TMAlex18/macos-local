diff --git a/crates/reims-vgpu-vulkan/src/gpu/encode_render/tests/framebuffer_fetch.rs b/crates/reims-vgpu-vulkan/src/gpu/encode_render/tests/framebuffer_fetch.rs
new file mode 100644
--- /dev/null
+++ b/crates/reims-vgpu-vulkan/src/gpu/encode_render/tests/framebuffer_fetch.rs
@@ -0,0 +1,315 @@
+//! Authored framebuffer-fetch consumer through Reims's serialized pipeline and render API.
+use super::*;
+use reims_vgpu_core::platform::resource::Library as _;
+use reims_vgpu_core::platform::types::MtlViewport;
+use reims_vgpu_core::platform::values::{
+    DepthAttachmentSet, DepthStencilDesc, StencilAttachmentSet, StencilDesc,
+};
+use reims_vgpu_core::rt::{Hold, Pool};
+
+/// Fetch colour 0, return half of it, then premultiplied source-over blend it in the
+/// ordered pixel interlock. Two draws must read each other's writes. The two unused colour
+/// attachments keep their clears, and rejecting depth/stencil states keep colour 0 too.
+#[test]
+fn fetched_half_float_source_over_keeps_order_tests_and_unused_attachments() {
+    catch_death(run_fetch).unwrap_or_else(|site| {
+        panic!(
+            "fetch consumer {site:?}: {:?}",
+            crate::answer::LAST_LINE.lock().take()
+        )
+    });
+}
+
+fn run_fetch() {
+    use crate::gpu::serialized::tests::rounded_render_of;
+    let _pool = Pool::here();
+    let (p, d) = (platform(), dev());
+    eprintln!(
+        "FETCH POLICY half_blend={:?}",
+        crate::platform::device_options().policy.half_blend
+    );
+    let vertex_code = include_bytes!(concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/../../tests/suite/fixtures/shaders/render_vbuf.metallib"
+    ));
+    let vertex_library = d.new_library(vertex_code).unwrap().unwrap().unwrap();
+    let vertex = vertex_library
+        .new_function(OnFault::Die, "render_vbuf")
+        .unwrap()
+        .unwrap();
+    let positions = buffer::<VulkanPlatform>(
+        &d,
+        48,
+        0,
+        &bytes(&[
+            -1.0, -1.0, 0.0, 1.0, 3.0, -1.0, 0.0, 1.0, -1.0, 3.0, 0.0, 1.0,
+        ]),
+    );
+    let vertex_color = buffer::<VulkanPlatform>(&d, 16, 0, &bytes(&[1.0; 4]));
+    let safe = include_bytes!(concat!(env!("OUT_DIR"), "/rounding_safe.metallib"));
+    for (math, code) in [("fast", ROUNDING), ("safe", safe.as_slice())] {
+        let library = d.new_library(code).unwrap().unwrap().unwrap();
+        for fragment in ["fetch_half_fragment", "fetch_float_fragment"] {
+            let function = |name| library.new_function(OnFault::Die, name).unwrap().unwrap();
+            let functions = [vertex.clone_ref(), function(fragment)];
+            let strict_refusal = math == "safe"
+                && fragment == "fetch_half_fragment"
+                && crate::platform::device_options().policy.half_blend
+                    == metal2vulkan::device::HalfBlendPolicy::Device;
+            let mut resolve = |_: Hold<'_>, r: u64| {
+                Ok(Some(functions[usize::try_from(r - 1).unwrap()].clone_ref()))
+            };
+            let colors: [&[(u8, u32)]; 3] = [
+                &[
+                    (0, 0),
+                    (1, 115),
+                    (2, 1),
+                    (3, 1),
+                    (4, 5),
+                    (5, 0),
+                    (6, 1),
+                    (7, 5),
+                    (8, 0),
+                    (9, 15),
+                ],
+                &[(0, 1), (1, 65), (9, 0)],
+                &[(0, 2), (1, 115), (9, 0)],
+            ];
+            let blob = rounded_render_of(
+                &["02 04 02000000", "09 04 04010000", "0a 04 04010000"],
+                &colors,
+                0,
+            );
+            let desc = d
+                .deserialize_render_pipeline_descriptor(Hold::NONE, &blob, &mut resolve)
+                .unwrap()
+                .unwrap();
+            let started = std::time::Instant::now();
+            let made = catch_death(|| d.new_render_pipeline_state_from_descriptor(Some(&desc), 0));
+            let state = made
+                .unwrap_or_else(|site| {
+                    panic!(
+                        "{math} {fragment}: {site:?}: {:?}",
+                        crate::answer::LAST_LINE.lock().take()
+                    )
+                })
+                .unwrap()
+                .unwrap()
+                .unwrap();
+            eprintln!(
+                "FETCH PIPELINE {math} {fragment} creation_seconds={:.6}",
+                started.elapsed().as_secs_f64()
+            );
+            // Exact binary16 values: d -> d*(1.5-d.a/2), with each draw fetching current d.
+            let expected = [
+                [0x3400u16, 0x3800, 0x3a00, 0x3800],
+                [0x3500, 0x3900, 0x3b80, 0x3900],
+                [0x35f0, 0x39f0, 0x3c74, 0x39f0],
+            ];
+            for (case, compare, depth_write, stencil, reference, draws_kept) in [
+                ("two ordered draws", 1, false, false, 0, 2usize),
+                ("depth rejects", 4, false, false, 0, 0),
+                ("first depth write rejects second", 1, true, false, 0, 1),
+                ("stencil rejects", 7, false, true, 1, 0),
+                (
+                    "first stencil increment rejects second",
+                    7,
+                    false,
+                    true,
+                    0,
+                    1,
+                ),
+            ] {
+                if strict_refusal && case != "two ordered draws" {
+                    continue;
+                }
+                let targets = [
+                    texture::<VulkanPlatform>(&p, &d, 115, READ | TARGET, (16, 16), None),
+                    texture::<VulkanPlatform>(&p, &d, 65, READ | TARGET, (16, 16), None),
+                    texture::<VulkanPlatform>(&p, &d, 115, READ | TARGET, (16, 16), None),
+                ];
+                let depth = texture::<VulkanPlatform>(&p, &d, 260, TARGET, (16, 16), None);
+                let pass = p.render_pass_descriptor();
+                for (i, t) in targets.iter().enumerate() {
+                    pass.set_color_attachment(
+                        OnFault::Die,
+                        u64::try_from(i).unwrap(),
+                        &ColorAttachmentSet {
+                            texture: Some(Some(t)),
+                            load_action: Some(CLEAR),
+                            store_action: Some(STORE),
+                            clear_color: Some(ClearColor {
+                                red: 0.25,
+                                green: 0.5,
+                                blue: 0.75,
+                                alpha: 0.5,
+                            }),
+                            ..ColorAttachmentSet::default()
+                        },
+                    )
+                    .unwrap();
+                }
+                pass.set_depth_attachment(&DepthAttachmentSet {
+                    texture: Some(Some(&depth)),
+                    load_action: Some(CLEAR),
+                    store_action: Some(STORE),
+                    clear_depth: Some(1.0),
+                    ..DepthAttachmentSet::default()
+                });
+                pass.set_stencil_attachment(&StencilAttachmentSet {
+                    texture: Some(Some(&depth)),
+                    load_action: Some(CLEAR),
+                    store_action: Some(STORE),
+                    clear_stencil: Some(0),
+                    ..StencilAttachmentSet::default()
+                });
+                let face = stencil.then_some(StencilDesc {
+                    stencil_compare_function: 2,
+                    depth_stencil_pass_operation: 3,
+                    read_mask: 0xff,
+                    write_mask: 0xff,
+                    ..StencilDesc::default()
+                });
+                let ds = d
+                    .new_depth_stencil_state(&DepthStencilDesc {
+                        depth_compare_function: Some(compare),
+                        depth_write_enabled: Some(depth_write),
+                        front: face,
+                        back: face,
+                    })
+                    .unwrap()
+                    .unwrap();
+                let q = d.new_command_queue().unwrap();
+                let cb = q.command_buffer(OnFault::Die).unwrap().unwrap();
+                let e = cb.render_encoder(OnFault::Die, &pass).unwrap().unwrap();
+                for (index, buffer) in [(0, &positions), (1, &vertex_color)] {
+                    e.encode(
+                        OnFault::Die,
+                        RenderCmd::SetVertexBuffer {
+                            buffer: Some(buffer),
+                            offset: 0,
+                            index,
+                        },
+                    )
+                    .unwrap();
+                }
+                e.encode(
+                    OnFault::Die,
+                    RenderCmd::SetRenderPipelineState {
+                        pipeline_state: Some(&state),
+                    },
+                )
+                .unwrap();
+                e.encode(
+                    OnFault::Die,
+                    RenderCmd::SetDepthStencilState {
+                        depth_stencil_state: Some(&ds),
+                    },
+                )
+                .unwrap();
+                e.encode(
+                    OnFault::Die,
+                    RenderCmd::SetStencilFrontReferenceValue {
+                        front_reference_value: reference,
+                        back_reference_value: reference,
+                    },
+                )
+                .unwrap();
+                e.encode(
+                    OnFault::Die,
+                    RenderCmd::SetViewport {
+                        viewport: MtlViewport {
+                            origin_x: 0.0,
+                            origin_y: 0.0,
+                            width: 16.0,
+                            height: 16.0,
+                            znear: 0.0,
+                            zfar: 1.0,
+                        },
+                    },
+                )
+                .unwrap();
+                for _ in 0..2 {
+                    let draw = || {
+                        e.encode(
+                            OnFault::Die,
+                            RenderCmd::DrawPrimitives {
+                                primitive_type: 3,
+                                vertex_start: 0,
+                                vertex_count: 3,
+                            },
+                        )
+                    };
+                    if strict_refusal {
+                        let site = catch_death(draw)
+                            .expect_err("default policy must retain strict half-blend refusal");
+                        let line = crate::answer::LAST_LINE.lock().take().unwrap_or_default();
+                        assert_eq!(site.file, "drawPrimitives:vertexStart:vertexCount:");
+                        assert!(line.contains("half") || line.contains("Half"), "{line}");
+                        eprintln!("FETCH EXPECTED STRICT REFUSAL {math} {fragment}: {line}");
+                        break;
+                    }
+                    draw().unwrap();
+                }
+                e.encode(OnFault::Die, RenderCmd::EndEncoding).unwrap();
+                if strict_refusal {
+                    // The adapter hears this notice inside the draw. A real caller aborts
+                    // there, so do not submit a command buffer after catching that refusal.
+                    eprintln!("FETCH STRICT REFUSAL PRESERVED; command buffer not committed");
+                    continue;
+                }
+                let output = buffer::<VulkanPlatform>(&d, 3 * 2048, 0, &[]);
+                let b = cb.blit_encoder(OnFault::Die).unwrap().unwrap();
+                for (i, t) in targets.iter().enumerate() {
+                    let bytes = if i == 1 { 4 } else { 8 };
+                    b.encode(
+                        OnFault::Die,
+                        BlitCmd::CopyTextureToBuffer {
+                            source_texture: t,
+                            source_slice: 0,
+                            source_level: 0,
+                            source_origin: MtlOrigin::new(0, 0, 0),
+                            source_size: MtlSize::new(16, 16, 1),
+                            destination_buffer: &output,
+                            destination_offset: u64::try_from(i * 2048).unwrap(),
+                            destination_bytes_per_row: 16 * bytes,
+                            destination_bytes_per_image: 256 * bytes,
+                        },
+                    )
+                    .unwrap();
+                }
+                b.encode(OnFault::Die, BlitCmd::EndEncoding).unwrap();
+                cb.commit(OnFault::Die).unwrap();
+                cb.wait_until_completed(OnFault::Die).unwrap();
+                assert!(
+                    cb.error().is_none(),
+                    "{math} {fragment} {case}: {:?}",
+                    cb.error()
+                );
+                // SAFETY: completed GPU-to-Shared readback, within the allocated buffer.
+                let got =
+                    unsafe { std::slice::from_raw_parts(output.contents().as_ptr::<u16>(), 3072) };
+                for i in 0..256 {
+                    assert_eq!(
+                        &got[i * 4..i * 4 + 4],
+                        &expected[draws_kept],
+                        "{math} {fragment} {case} pixel {i}"
+                    );
+                    assert_eq!(
+                        &got[1024 + i * 2..1026 + i * 2],
+                        &expected[0][..2],
+                        "unused RG16Float"
+                    );
+                    assert_eq!(
+                        &got[2048 + i * 4..2052 + i * 4],
+                        &expected[0],
+                        "unused RGBA16Float"
+                    );
+                }
+                eprintln!(
+                    "FETCH PASS {math} {fragment}: {case}; strict_refusal={strict_refusal}; 256 pixels, two unused attachments unchanged"
+                );
+            }
+        }
+    }
+}
