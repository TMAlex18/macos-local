+/// The mandatory-fetch source-over blend, at float precision. Both the destination read
+/// and its write remain inside the same ordered pixel interlock as the function's fetch.
+/// Half outputs retain their source-precision note; the exact half model remains opt-in.
+fn source_over_blended(
+    cx: &mut EmitCx<'_>,
+    fb: &mut FunctionBuilder<'_>,
+    color: u32,
+    sc: &StorageColor,
+    part: SValue,
+) -> BResult<SValue> {
+    if !sc.view.blend.is_some_and(source_over) {
+        return Err(cx.fail("a storage blend outside premultiplied source-over"));
+    }
+    let (image, at, operands) = image_and_texel(cx, fb, color, sc.view.samples)?;
+    let mem = memory_model::coherence(cx.plan).texel(fb)?;
+    let texel = fb.read(image, at, &operands, mem)?;
+    let destination = as_held(fb, texel, sc.view.numeric)?;
+    let vector = Form {
+        held: Held::Float(FloatFmt::F32),
+        lanes: 4,
+    };
+    let alpha = fb.vector_shuffle(part, part, &[3, 3, 3, 3])?;
+    let one = ops::splat(fb, vector, u64::from(1.0f32.to_bits()))?;
+    let remaining = fb.binary_no_contraction(BinOp::FSub, one, alpha)?;
+    let kept = fb.binary_no_contraction(BinOp::FMul, destination, remaining)?;
+    fb.binary_no_contraction(BinOp::FAdd, part, kept)
+}
