+/// Premultiplied source-over, in both RGB and alpha: source + destination*(1-source.a).
+/// This blend needs no second source or blend-color state.
+fn source_over(eq: BlendEquation) -> bool {
+    use crate::metal::{BlendFactor as F, BlendOperation as O};
+    eq == BlendEquation {
+        source_rgb: F::One,
+        destination_rgb: F::OneMinusSourceAlpha,
+        rgb_operation: O::Add,
+        source_alpha: F::One,
+        destination_alpha: F::OneMinusSourceAlpha,
+        alpha_operation: O::Add,
+    }
+}
+
+/// The first output's four floating-point lanes, with no second output at that color.
+fn floating_output4(cx: &SelectCx<'_>, color: u32) -> Result<Option<FloatFmt>, Error> {
+    let mut result = None;
+    for (o, ty) in cx
+        .entry
+        .ep
+        .outputs
+        .iter()
+        .zip(stage_io::output_types(cx)?.1)
+    {
+        if let OutputRole::RenderTarget {
+            attachment: AbiInt::Const(a),
+            index,
+            ..
+        } = o.role
+        {
+            if a != color {
+                continue;
+            }
+            if index != 0 {
+                return Ok(None);
+            }
+            let f = super::color::form(cx, ty)?;
+            if f.lanes == 4 && matches!(f.float_fmt(), Some(FloatFmt::Half | FloatFmt::F32)) {
+                result = f.float_fmt();
+            }
+        }
+    }
+    Ok(result)
+}
