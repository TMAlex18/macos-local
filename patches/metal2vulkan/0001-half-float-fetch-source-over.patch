+/// The source-over fetch uses storage inside the ordered interlock, beside depth/stencil
+/// and two masked-off attachments. Compile and validate the real authored AIR, not a plan mock.
+#[test]
+fn a_half_float_source_over_fetch_pipeline_compiles_ordered_beside_depth() {
+    use crate::device::requirements::VkFeature;
+    let (Some(io), Some(fetch)) = (fixture("stage_io"), fixture("exf_fetch_blend")) else {
+        return;
+    };
+    let vertex = Library::from_air(&io)
+        .unwrap()
+        .function("stage_io_vertex_position")
+        .unwrap();
+    let fragment = Library::from_air(&fetch)
+        .unwrap()
+        .function("exf_fetch_blend")
+        .unwrap();
+    let mut d =
+        RenderPipelineDescriptor::new(StageSource::Function(FunctionDescriptor::new(vertex)));
+    d.fragment = Some(StageSource::Function(FunctionDescriptor::new(fragment)));
+    let mut color = ColorAttachmentDescriptor::new(metal::PixelFormat::RGBA16Float);
+    color.blending_enabled = true;
+    color.destination_rgb_blend_factor = metal::BlendFactor::OneMinusSourceAlpha;
+    color.destination_alpha_blend_factor = metal::BlendFactor::OneMinusSourceAlpha;
+    d.color_attachments[0] = Some(color);
+    for (i, pf) in [
+        (1, metal::PixelFormat::RG16Float),
+        (2, metal::PixelFormat::RGBA16Float),
+    ] {
+        let mut c = ColorAttachmentDescriptor::new(pf);
+        c.write_mask = metal::ColorWriteMask::NONE;
+        d.color_attachments[i] = Some(c);
+    }
+    d.depth_format = Some(metal::PixelFormat::Depth32FloatStencil8);
+    d.stencil_format = d.depth_format;
+    for policy in [
+        DevicePolicy::default(),
+        DevicePolicy::default().exact_answers(),
+    ] {
+        let dev = Device::new(description("nvidia-rtx50-linux"), policy).unwrap();
+        let pipe = dev
+            .compile_render_pipeline(&d, &Budget::standard())
+            .unwrap();
+        assert!(pipe
+            .requirements
+            .features
+            .contains(&VkFeature::FragmentShaderPixelInterlock));
+        assert!(pipe.graphics.input_attachments.is_empty());
+        assert_eq!(pipe.graphics.storage_attachments.len(), 1);
+        assert_eq!(pipe.graphics.storage_attachments[0].color_index, 0);
+        for stage in &pipe.stages {
+            l3(&stage.spirv, &pipe.requirements, &dev);
+        }
+    }
+}
