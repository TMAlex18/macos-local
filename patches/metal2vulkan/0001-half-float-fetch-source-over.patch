+/// A fetched half-float target can do premultiplied source-over in the same ordered lock;
+/// the existing coverage, amplification and late-test guards are still binding.
+#[test]
+fn source_over_keeps_the_storage_forms_test_guards() {
+    use crate::metal::{BlendFactor as F, BlendOperation as O};
+    let p = profile("nvidia-rtx50-linux", &[]);
+    let mut inputs = state(PixelFormat::RGBA16Float, |c| {
+        c.blending_enabled = true;
+        c.source_rgb_blend_factor = F::One;
+        c.destination_rgb_blend_factor = F::OneMinusSourceAlpha;
+        c.rgb_blend_operation = O::Add;
+        c.source_alpha_blend_factor = F::One;
+        c.destination_alpha_blend_factor = F::OneMinusSourceAlpha;
+        c.alpha_blend_operation = O::Add;
+    });
+    inputs.depth_or_stencil = true;
+    assert!(form(&inputs, false, WRITES, &p)
+        .unwrap()
+        .blend
+        .is_some_and(source_over));
+    let late = ColorUse {
+        early_tests: false,
+        ..WRITES
+    };
+    assert_eq!(form(&inputs, false, late, &p), Err(not_implemented()));
+    assert!(form(
+        &inputs,
+        false,
+        ColorUse {
+            draw_tested: true,
+            ..late
+        },
+        &p
+    )
+    .is_ok());
+    inputs.alpha_to_coverage = true;
+    assert_eq!(form(&inputs, false, WRITES, &p), Err(not_implemented()));
+    inputs.alpha_to_coverage = false;
+    inputs.amplified = true;
+    assert_eq!(form(&inputs, false, WRITES, &p), Err(not_implemented()));
+}
