--- !tapi-tbd
tbd-version: 4
targets: [ arm64-macos ]
install-name: '/usr/lib/libSystem.B.dylib'
current-version: 1
compatibility-version: 1
exports:
  - targets: [ arm64-macos ]
    symbols: [ _printf, _fflush, _write, _getpid, _time, _sleep, _clock,
               _mach_absolute_time, _mach_timebase_info, _dlopen, _dlsym,
               _dlerror, dyld_stub_binder ]
...
